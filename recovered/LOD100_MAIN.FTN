C+++ .MAIN.
C****** LOD100 MAINLINE = RECONSTRUCTION
C
C       NOT RECOVERED FPS SOURCE.  THE MAINLINE IS ONE OF THE MODULES
C       LOST WITH THE HEAD OF LOD100.FTN; THE OTHER 40 SURVIVE.
C
C       ITS SHAPE IS NOT INVENTED.  COMAND IS RECOVERED, AND IT RETURNS
C       THE INDEX OF A COMMAND IN ITS OWN CMNDS LIST, SO THAT LIST'S
C       ORDER IS THE DISPATCH ORDER:
C
C        1 LO   2 MAP  3 XX   4 HE   5 LIN  6 EX   7 F    8 OU   9 C
C       10 LF  11 OV  12 N   13 LM  14 PP  15 DE  16 B   17 INI 18 LIB
C       19 A   20 MD  21 PS  22 PM  23 MM  24 R   25 INP 26 EC  27 DU
C       28 TR  29 MO  30 HS  31 TA  32 PR  33 MAR 34 PU
C
C       24 OF THESE ARE MANUAL 2.3 COMMANDS.  TEN ARE UNDOCUMENTED --
C       XX HE LIN LF DE B A EC DU HS -- AND ARE ROUTED TO ERRMES RATHER
C       THAN SILENTLY IGNORED, SO A COMMAND FILE USING ONE FAILS LOUDLY
C       INSTEAD OF PRODUCING A QUIETLY WRONG LOAD MODULE.
C
C       EVERY HANDLER CALLED HERE IS A RECOVERED MODULE, USED WITH ITS
C       OWN SIGNATURE.
C
        INTEGER CMD,COMAND,RDLIN,IZ
        COMMON /LDTABS/ PRGDTA (503),PRGMAX,ENTDTA(503),ENTMAX,         LDTABS
     *                EXTDTA(283),EXTMAX,EX1PTR,                        LDTABS
     *                OLUN,RADIX,CLUN,MDLOW,PSLOW,                      LDTABS
     *                PSBRK,DBDTA1(203),DB1MAX,DBDTA2(150,2),DB2MAX,    LDTABS
     *                DB2PTR,OVDTA(16,9),OVPTR,OVMAX,LRADIX,PSMAX,      LDTABS
     *                DBST,DBBRK,DB0PTR,DB0MAX,DBDTA0(70),              LDTABS
     *                EXTDT1(200),                                      LDTABS
     *                EXTMX1,ENTDT1(100),ENTMX1,ENTPT1,LMLUN,           LDTABS
     *                PARDTA(100),PARMAX,PARPTR,FLUN,VARSIZ(3),         LDTABS
     *                CNTMAX,PARADR,MAXPAR,OVID,OVFLG,LMID,             LDTABS
     *                OVPG,DBPG,BUFFER(200),BUFSIZ,PAKFAC,              LDTABS
     *                DBLUN,EKOFLG,EKOLUN,CLUNS(2),CCLUN,CUROV,         LDTABS
     *                NOTUS1,NOTUS2,NOTUS3,LUNMAP,OFFSET,EXTHST,M65536  LDTABS
        COMMON /LDTABS/ SFFIL(31),SOFIL(31),SLMFIL(31),PGINFO(16,2)     LDTABS
        COMMON /LDTABS/ SCLUN(16),SCLUN2(16),CLUN2                      LDTABS
        COMMON /LDTABS/ PPASZ,OTOFLG,OVLEVL,CALFLG,CMPFLG,RSTRCT,       LDTABS
     *                  PSHLD,OV1FLG,MAPLUN,NAMLUN,LP2LUN,SLP2NM(16)    LDTABS
        COMMON /LDTABS/FLMLUN,FLMFIL,LMLDSW,MXDATA,SUBCNT,              LDTABS
     *               CODPTR,LMHDRC                                      LDTABS
        INTEGER PRGDTA,PRGMAX,ENTDTA,ENTMAX,                            LDTABS
     *          EXTDTA,EXTMAX,EX1PTR,                                   LDTABS
     *          OLUN,RADIX,CLUN,MDLOW,PSLOW,                            LDTABS
     *          PSBRK,DBDTA1,DB1MAX,DBDTA2,DB2MAX,                      LDTABS
     *          DB2PTR,OVDTA,OVPTR,OVMAX,LRADIX,PSMAX,                  LDTABS
     *          DBST,DBBRK,DB0PTR,DB0MAX,DBDTA0,EXTDT1,                 LDTABS
     *          EXTMX1,ENTDT1,ENTMX1,ENTPT1,LMLUN,                      LDTABS
     *          PARDTA,PARMAX,PARPTR,FLUN,VARSIZ,                       LDTABS
     *          CNTMAX,PARADR,MAXPAR,OVID,OVFLG,LMID,                   LDTABS
     *          OVPG,DBPG,BUFFER,BUFSIZ,PAKFAC,                         LDTABS
     *          DBLUN,EKOFLG,EKOLUN,CLUNS,CCLUN,CUROV,                  LDTABS
     *          NOTUS1,NOTUS2,NOTUS3,LUNMAP,OFFSET,EXTHST,M65536        LDTABS
        INTEGER SFFIL,SOFIL,SLMFIL,PGINFO                               LDTABS
        INTEGER SCLUN,SCLUN2,CLUN2                                      LDTABS
        INTEGER PPASZ,OTOFLG,OVLEVL,CALFLG,CMPFLG,RSTRCT,PSHLD,OV1FLG   LDTABS
        INTEGER MAPLUN,NAMLUN,LP2LUN,SLP2NM                             LDTABS
        INTEGER FLMLUN,FLMFIL(31),LMLDSW,MXDATA,SUBCNT,                 LDTABS
     *           CODPTR,LMHDRC(8)                                       LDTABS
       INTEGER TSKDTA(26,8),TSKPTR,TSKMAX,TCBMNL,TCBMXL                 COMMON10
       INTEGER SPRGDT,SENTPT,SENTDT,SEXTPT,SEXTDT,SPARPT                COMMON10
       INTEGER SDB0PT,SDB1PT,SDB2PT,PSTOP                               COMMON10
       INTEGER ISRMDA,ISRPSA,ISRIDX,ISRLEN                              COMMON10
       INTEGER OVPDTA(50,3),PSPDTA(50),OVPPTR,PSPPTR,PSPMAX,OVPMAX      COMMON10
       LOGICAL TASKFL,TSKFL,ISRFL,IOPENX                                COMMON10
       COMMON /TSKCOM/ TSKDTA,TSKPTR,TSKMAX,TCBMNL,TCBMXL,              COMMON10
     -         SPRGDT,SENTPT,SENTDT,SEXTPT,SEXTDT,                      COMMON10
     -         SPARPT,SDB0PT,SDB1PT,SDB2PT,PSTOP,                       COMMON10
     -         ISRMDA,ISRPSA,ISRIDX,ISRLEN,                             COMMON10
     -         OVPDTA,PSPDTA,OVPPTR,PSPPTR,PSPMAX,OVPMAX,               COMMON10
     -         TASKFL,TSKFL,ISRFL                                       COMMON10
        INTEGER ILUN,STR,IPTR,SYM,INDX                                  MAINCOM
        INTEGER IFLG,IV,OVSKIP,IV2,TREFLG                               MAINCOM
        INTEGER I,II,J,JJ,ID,OVMESZ,SFILE1                              MAINCOM
        INTEGER OVEPT,SYM2,LFFLG                                        MAINCOM
        INTEGER LIBFLG,COUNT,IRADIX,SFILE,IPTLUN                        MAINCOM
        INTEGER BAKPTR,LRPTR,LNKCNT,ITTO,TOVID,TOVPG                    MAINCOM
        INTEGER RSTPTR,LNKFLG,OVBKSZ,OVPSLW,OVBKAD                      MAINCOM
        INTEGER APOVEN,OVLDEN,PSCNT,IZ1QS                               MAINCOM
        COMMON /MCOMM/ ILUN,STR(81),IPTR,SYM(8),INDX,                   MAINCOM
     *   IFLG,IV,OVSKIP,IV2,TREFLG,                                     MAINCOM
     *   I,II,J,JJ,ID,OVMESZ,SFILE1(16),                                MAINCOM
     *   OVEPT,SYM2(8),LFFLG,                                           MAINCOM
     *   LIBFLG,COUNT,IRADIX,SFILE(31),IPTLUN,                          MAINCOM
     *   BAKPTR,LRPTR,LNKCNT,ITTO,TOVID,TOVPG,                          MAINCOM
     *   RSTPTR,LNKFLG,OVBKSZ,OVPSLW,OVBKAD,                            MAINCOM
     *   APOVEN,OVLDEN,PSCNT,IZ1QS                                      MAINCOM
       COMMON /OPENX/ IOPENX                                            COMMON10
C
C       INITIALISE.  INIT TAKES TWO FLAGS; A COLD START IS 0,0.
C
C       ASSIGN THE FILE NUMBERS BEFORE INIT.  INIT ASSIGNS NONE OF THEM
C       -- IT ONLY USES THEM, "INFILE (7,SCLUN,CLUN)" AND SO ON -- SO
C       THIS IS THE MAINLINE'S JOB, AND LEAVING THEM ZERO MAKES THE
C       FIRST INFILE FAIL WITH "INVALID LOGICAL UNIT NUMBER".
C
C       THE COUNT IS FIXED BY LOD100.CMD, WHICH ASKS FOR UNITS=17: TEN
C       FILE NUMBERS, PLUS THE SEVEN FDUTIL ADDS WHEN IT MAPS A FILE
C       NUMBER TO A FORTRAN UNIT.  WHICH VARIABLE HELD WHICH NUMBER IS
C       LOST WITH THE ORIGINAL MAINLINE; THESE ARE DISTINCT AND WITHIN
C       THE TEN.
C
        CLUN=1
        CLUNS(1)=1
        CLUNS(2)=2
        CLUN2=2
        FLUN=3
        LMLUN=4
        FLMLUN=5
        DBLUN=6
        MAPLUN=7
        NAMLUN=8
        LP2LUN=9
        LUNMAP=0
C
C       IPTLUN IS TESTED AGAINST -1, NOT 0, SO -1 IS ITS "UNUSED"
C       VALUE -- FINISH: "IF (IPTLUN .NE. -1) ID=INFILE (4,ID,IPTLUN)".
C
        IPTLUN=-1
        EKOFLG=0
        EKOLUN=10
        CALL INIT (0,0)
C
C       COMMAND INPUT.  INIT OPENS THE SCRATCH FILE -- ITS
C       "INFILE (7,SCLUN,CLUN)", OP 7 BEING AN OPEN -- BUT IT DOES NOT
C       SET ILUN, THE COMMAND INPUT UNIT.  THAT IS THE MAINLINE'S JOB,
C       AND LEAVING IT ZERO MAKES THE FIRST RDLIN FAIL WITH A FORTRAN
C       OTS ERROR BEFORE ANY COMMAND IS READ.
C
C       ILUN IS A FILE NUMBER, NOT A FORTRAN UNIT, AND A NEGATIVE ONE
C       MEANS THE TERMINAL.  RDLIN'S OWN CODE SETTLES IT:
C
C           LU = LUN
C           IF (LUN .GT. 0) LU = LUN + 7      FILE NUMBER -> UNIT
C           IF (LUN .GE. 0) GO TO 20
C           READ (5,...)                      LUN < 0: THE TERMINAL
C       20  READ (LU,...)
C
C       The recovered code uses the convention the same way -- COMAND's
C       "CALL WRTLIN (CMNDS(PC),-1,-1)" writes to the terminal.  ILUN=5
C       read unit 12, which nothing had opened, so every RDLIN returned
C       end of file at once.  The INPUT command replaces this with a
C       real file number; manual 2.3.1: "an end-of-file causes commands
C       to be read from the terminal again".
C
        ILUN=-1
C
C       ITTO IS A REAL FORTRAN UNIT: the -1 convention is interpreted by
C       FDUTIL's RDLIN and WRTLIN, not by a raw WRITE, and WRITE to unit
C       -1 gives "INVALID LOGICAL UNIT NUMBER".  WRTLIN itself writes to
C       unit 5 for a negative LUN, so 5 is the terminal here.  Nothing
C       in the recovered 40 references ITTO -- it belongs to the modules
C       that were lost.
C
        ITTO=5
C
C       THE STARTUP DIALOGUE IS MANUAL 2.2: LOD100 ANNOUNCES ITSELF AND
C       THEN PROMPTS WITH AN ASTERISK, AND "AFTER LOD100 PROCESSES EACH
C       COMMAND, IT DISPLAYS THE ASTERISK TO INDICATE THAT ANOTHER
C       COMMAND CAN BE ENTERED".
C
        WRITE (ITTO,9800)
9800    FORMAT (' LOD100  REL. 1.01 , RECONSTRUCTION')
C
C       COMMAND LOOP.
C
100     CONTINUE
        WRITE (ITTO,9810)
9810    FORMAT (' *')
        IPTR=1
        IF (RDLIN (STR,ILUN,80) .LT. 0) GO TO 900
C
C       MATCH ON AT MOST THREE CHARACTERS.  COMAND's own code:
C           LEN = MIN0 (MAXLEN,3)
C           IF (CMPSS(CMNDS(PC),STR,MIN0(CMNDS(PC),LEN)).EQ.0) ...
C       so it compares the shorter of the list entry and LEN, capped at
C       three -- which is why the list holds LO, MAP, LIN, INI, MAR.
C       Passing -1 makes LEN -1 and nothing ever matches.
C
        CMD=COMAND (0,STR,3)
        IF (CMD .LT. 1 .OR. CMD .GT. 34) GO TO 800
        GO TO (1001,1002,1099,1099,1099,1006,1007,1008,1009,
     *         1099,1011,1012,1013,1014,1099,1099,1017,1018,
     *         1099,1020,1021,1022,1023,1024,1025,1099,1099,
     *         1028,1029,1099,1031,1032,1033,1034), CMD
C
C       LO -- LOAD
1001    CALL LOAD (0,STR,IPTR,LIBFLG,LFFLG)
        GO TO 100
C       MAP
1002    CALL LOADMP
        GO TO 100
C       EX -- EXIT.  FINISH CLOSES THE FILES AND WRITES THE END BLOCK.
1006    CALL LINKS
        CALL FINISH
        GO TO 900
C       F -- FORCE
1007    CALL FORCE (STR,IPTR,SYM)
        GO TO 100
C       OU -- OUTPUT
1008    CALL OUTPUT
        GO TO 100
C       C -- CALL
1009    CALL CALLS
        GO TO 100
C       OV -- OVERLAY
1011    CALL OVLY (STR,IPTR,IRADIX,LNKFLG,SYM)
        GO TO 100
C       N -- NOLOAD
1012    CALL NOLOAD
        GO TO 100
C       LM -- LMID
1013    CONTINUE
        GO TO 100
C       PP -- PPA
1014    CONTINUE
        GO TO 100
C       INI -- INIT
1017    CALL INIT (1,0)
        GO TO 100
C       LIB
1018    CALL LIB
        GO TO 100
C       MD -- MDOFF
1020    CALL MDOFF
        GO TO 100
C       PS -- PSOFF
1021    CALL PSOFF
        GO TO 100
C       PM -- PMAX
1022    CONTINUE
        GO TO 100
C       MM -- MMAX
1023    CALL MMAX
        GO TO 100
C       R -- RADIX
1024    CONTINUE
        GO TO 100
C       INP -- INPUT
1025    CALL INPUT
        GO TO 100
C       TR -- TREE
1028    CALL TREE (STR,IPTR,IRADIX,0,SYM)
        GO TO 100
C       MO -- MODE
1029    CONTINUE
        GO TO 100
C       TA -- TASK
1031    CALL TASKY (STR,IPTR,0,IRADIX)
        GO TO 100
C       PR -- PRI
1032    CONTINUE
        GO TO 100
C       MAR -- MARK
1033    CALL MARK
        GO TO 100
C       PU -- PURGE
1034    CALL PURGE
        GO TO 100
C
C       UNDOCUMENTED COMMAND -- PRESENT IN COMAND'S LIST, NO RECOVERED
C       HANDLER AND NO SPECIFICATION.  SAY SO.
C
1099    CONTINUE
        CALL ERRMES (1)
        GO TO 100
C
C       UNRECOGNISED COMMAND
C
800     CONTINUE
        CALL ERRMES (1)
        GO TO 100
900     CONTINUE
        STOP
        END
