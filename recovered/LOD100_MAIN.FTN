C+++ .MAIN.
C****** LOD100 MAINLINE = RECONSTRUCTION
C
C       NOT RECOVERED FPS SOURCE.  THE MAINLINE IS ONE OF THE MODULES
C       LOST WITH THE HEAD OF LOD100.FTN; THE OTHER 40 SURVIVE.
C
C       ITS SHAPE IS NOT INVENTED.  COMAND IS RECOVERED, AND IT RETURNS
C       THE INDEX OF A COMMAND IN ITS OWN CMNDS LIST, SO THAT LIST'S
C       ORDER IS THE DISPATCH ORDER:
C
C        1 LO   2 MAP  3 XX   4 HE   5 LIN  6 EX   7 F    8 OU   9 C
C       10 LF  11 OV  12 N   13 LM  14 PP  15 DE  16 B   17 INI 18 LIB
C       19 A   20 MD  21 PS  22 PM  23 MM  24 R   25 INP 26 EC  27 DU
C       28 TR  29 MO  30 HS  31 TA  32 PR  33 MAR 34 PU
C
C       24 OF THESE ARE MANUAL 2.3 COMMANDS.  TEN ARE UNDOCUMENTED --
C       XX HE LIN LF DE B A EC DU HS -- AND ARE ROUTED TO ERRMES RATHER
C       THAN SILENTLY IGNORED, SO A COMMAND FILE USING ONE FAILS LOUDLY
C       INSTEAD OF PRODUCING A QUIETLY WRONG LOAD MODULE.
C
C       EVERY HANDLER CALLED HERE IS A RECOVERED MODULE, USED WITH ITS
C       OWN SIGNATURE.
C
        INTEGER CMD,COMAND,RDLIN,IZ,NCH,IAND16,IRD,INFILE
        INTEGER DBSCR(2)
        COMMON /LDTABS/ PRGDTA (503),PRGMAX,ENTDTA(503),ENTMAX,         LDTABS
     *                EXTDTA(283),EXTMAX,EX1PTR,                        LDTABS
     *                OLUN,RADIX,CLUN,MDLOW,PSLOW,                      LDTABS
     *                PSBRK,DBDTA1(203),DB1MAX,DBDTA2(150,2),DB2MAX,    LDTABS
     *                DB2PTR,OVDTA(16,9),OVPTR,OVMAX,LRADIX,PSMAX,      LDTABS
     *                DBST,DBBRK,DB0PTR,DB0MAX,DBDTA0(70),              LDTABS
     *                EXTDT1(200),                                      LDTABS
     *                EXTMX1,ENTDT1(100),ENTMX1,ENTPT1,LMLUN,           LDTABS
     *                PARDTA(100),PARMAX,PARPTR,FLUN,VARSIZ(3),         LDTABS
     *                CNTMAX,PARADR,MAXPAR,OVID,OVFLG,LMID,             LDTABS
     *                OVPG,DBPG,BUFFER(200),BUFSIZ,PAKFAC,              LDTABS
     *                DBLUN,EKOFLG,EKOLUN,CLUNS(2),CCLUN,CUROV,         LDTABS
     *                NOTUS1,NOTUS2,NOTUS3,LUNMAP,OFFSET,EXTHST,M65536  LDTABS
        COMMON /LDTABS/ SFFIL(31),SOFIL(31),SLMFIL(31),PGINFO(16,2)     LDTABS
        COMMON /LDTABS/ SCLUN(16),SCLUN2(16),CLUN2                      LDTABS
        COMMON /LDTABS/ PPASZ,OTOFLG,OVLEVL,CALFLG,CMPFLG,RSTRCT,       LDTABS
     *                  PSHLD,OV1FLG,MAPLUN,NAMLUN,LP2LUN,SLP2NM(16)    LDTABS
        COMMON /LDTABS/FLMLUN,FLMFIL,LMLDSW,MXDATA,SUBCNT,              LDTABS
     *               CODPTR,LMHDRC                                      LDTABS
        INTEGER PRGDTA,PRGMAX,ENTDTA,ENTMAX,                            LDTABS
     *          EXTDTA,EXTMAX,EX1PTR,                                   LDTABS
     *          OLUN,RADIX,CLUN,MDLOW,PSLOW,                            LDTABS
     *          PSBRK,DBDTA1,DB1MAX,DBDTA2,DB2MAX,                      LDTABS
     *          DB2PTR,OVDTA,OVPTR,OVMAX,LRADIX,PSMAX,                  LDTABS
     *          DBST,DBBRK,DB0PTR,DB0MAX,DBDTA0,EXTDT1,                 LDTABS
     *          EXTMX1,ENTDT1,ENTMX1,ENTPT1,LMLUN,                      LDTABS
     *          PARDTA,PARMAX,PARPTR,FLUN,VARSIZ,                       LDTABS
     *          CNTMAX,PARADR,MAXPAR,OVID,OVFLG,LMID,                   LDTABS
     *          OVPG,DBPG,BUFFER,BUFSIZ,PAKFAC,                         LDTABS
     *          DBLUN,EKOFLG,EKOLUN,CLUNS,CCLUN,CUROV,                  LDTABS
     *          NOTUS1,NOTUS2,NOTUS3,LUNMAP,OFFSET,EXTHST,M65536        LDTABS
        INTEGER SFFIL,SOFIL,SLMFIL,PGINFO                               LDTABS
        INTEGER SCLUN,SCLUN2,CLUN2                                      LDTABS
        INTEGER PPASZ,OTOFLG,OVLEVL,CALFLG,CMPFLG,RSTRCT,PSHLD,OV1FLG   LDTABS
        INTEGER MAPLUN,NAMLUN,LP2LUN,SLP2NM                             LDTABS
        INTEGER FLMLUN,FLMFIL(31),LMLDSW,MXDATA,SUBCNT,                 LDTABS
     *           CODPTR,LMHDRC(8)                                       LDTABS
       INTEGER TSKDTA(26,8),TSKPTR,TSKMAX,TCBMNL,TCBMXL                 COMMON10
       INTEGER SPRGDT,SENTPT,SENTDT,SEXTPT,SEXTDT,SPARPT                COMMON10
       INTEGER SDB0PT,SDB1PT,SDB2PT,PSTOP                               COMMON10
       INTEGER ISRMDA,ISRPSA,ISRIDX,ISRLEN                              COMMON10
       INTEGER OVPDTA(50,3),PSPDTA(50),OVPPTR,PSPPTR,PSPMAX,OVPMAX      COMMON10
       LOGICAL TASKFL,TSKFL,ISRFL,IOPENX                                COMMON10
       COMMON /TSKCOM/ TSKDTA,TSKPTR,TSKMAX,TCBMNL,TCBMXL,              COMMON10
     -         SPRGDT,SENTPT,SENTDT,SEXTPT,SEXTDT,                      COMMON10
     -         SPARPT,SDB0PT,SDB1PT,SDB2PT,PSTOP,                       COMMON10
     -         ISRMDA,ISRPSA,ISRIDX,ISRLEN,                             COMMON10
     -         OVPDTA,PSPDTA,OVPPTR,PSPPTR,PSPMAX,OVPMAX,               COMMON10
     -         TASKFL,TSKFL,ISRFL                                       COMMON10
        INTEGER ILUN,STR,IPTR,SYM,INDX                                  MAINCOM
        INTEGER IFLG,IV,OVSKIP,IV2,TREFLG                               MAINCOM
        INTEGER I,II,J,JJ,ID,OVMESZ,SFILE1                              MAINCOM
        INTEGER OVEPT,SYM2,LFFLG                                        MAINCOM
        INTEGER LIBFLG,COUNT,IRADIX,SFILE,IPTLUN                        MAINCOM
        INTEGER BAKPTR,LRPTR,LNKCNT,ITTO,TOVID,TOVPG                    MAINCOM
        INTEGER RSTPTR,LNKFLG,OVBKSZ,OVPSLW,OVBKAD                      MAINCOM
        INTEGER APOVEN,OVLDEN,PSCNT,IZ1QS                               MAINCOM
        COMMON /MCOMM/ ILUN,STR(81),IPTR,SYM(8),INDX,                   MAINCOM
     *   IFLG,IV,OVSKIP,IV2,TREFLG,                                     MAINCOM
     *   I,II,J,JJ,ID,OVMESZ,SFILE1(16),                                MAINCOM
     *   OVEPT,SYM2(8),LFFLG,                                           MAINCOM
     *   LIBFLG,COUNT,IRADIX,SFILE(31),IPTLUN,                          MAINCOM
     *   BAKPTR,LRPTR,LNKCNT,ITTO,TOVID,TOVPG,                          MAINCOM
     *   RSTPTR,LNKFLG,OVBKSZ,OVPSLW,OVBKAD,                            MAINCOM
     *   APOVEN,OVLDEN,PSCNT,IZ1QS                                      MAINCOM
       COMMON /OPENX/ IOPENX                                            COMMON10
C
C       INITIALISE.  INIT TAKES TWO FLAGS; A COLD START IS 0,0.
C
C       ASSIGN THE FILE NUMBERS BEFORE INIT.  INIT ASSIGNS NONE OF THEM
C       -- IT ONLY USES THEM, "INFILE (7,SCLUN,CLUN)" AND SO ON -- SO
C       THIS IS THE MAINLINE'S JOB, AND LEAVING THEM ZERO MAKES THE
C       FIRST INFILE FAIL WITH "INVALID LOGICAL UNIT NUMBER".
C
C       THE COUNT IS FIXED BY LOD100.CMD, WHICH ASKS FOR UNITS=17: TEN
C       FILE NUMBERS, PLUS THE SEVEN FDUTIL ADDS WHEN IT MAPS A FILE
C       NUMBER TO A FORTRAN UNIT.  WHICH VARIABLE HELD WHICH NUMBER IS
C       LOST WITH THE ORIGINAL MAINLINE; THESE ARE DISTINCT AND WITHIN
C       THE TEN.
C
        CLUN=1
        CLUNS(1)=1
        CLUNS(2)=2
        CLUN2=2
        FLUN=3
        LMLUN=4
        FLMLUN=5
        DBLUN=6
        MAPLUN=7
        NAMLUN=8
        LP2LUN=9
C
C       LUNMAP IS THE FILE-NUMBER-TO-FORTRAN-UNIT BIAS, AND IT IS SEVEN,
C       NOT ZERO.  FPS'S OWN CODE USES IT DIRECTLY -- FINISH DOES
C       "LUNX=FLUN+LUNMAP" AND THEN WRITES ON LUNX, WHILE THE FILE ON
C       FLUN WAS OPENED THROUGH INFILE, WHICH MAPS FILE N TO UNIT N+7.
C       THE TWO MUST AGREE OR EVERY DIRECT WRITE GOES TO A UNIT NOBODY
C       OPENED.  ASM100 BRACKETS ITS OWN INFILE CALLS WITH THE SAME
C       CONSTANT -- "SLUN = SLUN + 7" UNDER THE COMMENT "MAP LOGICAL
C       UNIT NUMBERS HERE IF NECESSARY".
C
        LUNMAP=7
C
C       OVMESZ IS THE OVERLAY-MAP ENTRY SIZE IN MAIN-DATA WORDS.  LINKS
C       READS IT TWICE -- "IVAL(3)=OVPTR*OVMESZ" FOR THE INFO RECORD'S
C       OVLEN, AND "OVPDTA(OVPPTR,1)=DBBRK+(I-1)*OVMESZ" FOR EACH MAP
C       ENTRY'S ADDRESS -- AND SETS IT NOWHERE, SO LIKE OVFLG, LUNMAP,
C       CMPFLG AND PARMAX IT IS THE MAINLINE'S.  LEFT ZERO IT MAKES THE
C       INFO RECORD REPORT AN OVERLAY MAP OF LENGTH 0.
C
C       IT IS THE TASK-MODE ENTRY SIZE, 8, UNCONDITIONALLY.  LINKS HALVES
C       IT ITSELF FOR A JOB WITHOUT TASKS --
C
C           IVAL(3)=OVPTR*OVMESZ
C           IF (.NOT.TASKFL) IVAL(3)=IVAL(3)/2
C
C       WHICH MATCHES THE ENTRY IT ACTUALLY WRITES: "J" ADVANCES BY 8
C       HOST WORDS (4 MD WORDS) IN GENERAL AND BY TWICE THAT UNDER
C       "IF (.NOT.TASKFL) GO TO 6540", BECAUSE THE TASK ID, RESIDENCY,
C       PARTITION POINTER AND PARTITION COUNT ONLY EXIST WHEN TASKS ARE
C       BEING BUILT.  THE OTHER READER, "OVPDTA(OVPPTR,1)=DBBRK+(I-1)*
C       OVMESZ", RUNS ONLY UNDER TASKFL, WHERE THE STRIDE IS 8.
C
C       SETTING IT TO 4 MAKES THE INFO RECORD REPORT AN OVERLAY MAP HALF
C       ITS REAL LENGTH, SINCE THE HALVING THEN APPLIES TWICE.
C
        OVMESZ=8
C
C       IPTLUN IS THE FILE NUMBER OF THE INDIRECT COMMAND FILE THAT THE
C       DOCUMENTED "INPUT filename" COMMAND OPENS (LOADER 2.3.1).  IT
C       IS A FILE NUMBER, NOT A FLAG: INPUT DOES
C
C           ILUN=IPTLUN
C           IF (INFILE (1,SFILE,ILUN) .EQ. 0) GOTO 500
C           CALL ERRMES (10)
C           ILUN=-1
C
C       WITHOUT EVER ASSIGNING IT, SO THE MAINLINE OWNED IT LIKE EVERY
C       OTHER FILE NUMBER.  -1 IS ILUN'S "READ FROM THE TERMINAL"
C       VALUE, NOT IPTLUN'S; AN EARLIER READING OF FINISH'S DEFENSIVE
C       "IF (IPTLUN .NE. -1)" PUT -1 HERE AND THE INPUT COMMAND THEN
C       READ THE TERMINAL AND DIED IN RDLIN WITH ERROR 1, READ ERROR.
C
C       IT TAKES NAMLUN'S NUMBER: NAMLUN IS NAMED IN /LDTABS/ BUT NO
C       RECOVERED MODULE READS OR WRITES IT, AND TEN FILE NUMBERS IS
C       ALL LOD100.CMD'S UNITS=17 ALLOWS.
C
        IPTLUN=8
        EKOFLG=0
C       OLUN IS THE OBJECT FILE UNIT.  It appears 154 times in the
C       recovered modules and is ASSIGNED BY NONE of them -- the same
C       pattern as the file numbers and the table limits.  RDREC reads
C       through it, so LOAD dies in RDLIN without it.
C
C       Ten file numbers is what LOD100.CMD's UNITS=17 allows, so OLUN
C       shares with EKOLUN: the echo unit is only live when EKOFLG=1,
C       and that is off.
C
        OLUN=10
        EKOLUN=10
C       THE TABLE LIMITS ARE THE MAINLINE'S TOO.  INIT DOES NOT SET
C       THEM EITHER, AND WITH EVERY MAX AT ZERO THE CROCK TABLE PACKAGE
C       OVERFLOWS ON THE FIRST INSERT -- LOADER ERROR 16, "TOO MANY
C       DATA, A TABLE OVERFLOW HAS OCCURRED".
C
C       EACH LIMIT IS THE DECLARED DIMENSION OF ITS TABLE, TAKEN FROM
C       THE RECOVERED COMMON BLOCKS -- DERIVED, NOT CHOSEN.
C
        PRGMAX=503
        ENTMAX=503
        EXTMAX=283
        EXTMX1=200
        ENTMX1=100
        DB0MAX=70
        DB1MAX=203
        DB2MAX=150
        PARMAX=100
        BUFSIZ=200
        OVMAX=16
        TSKMAX=26
        OVPMAX=50
        PSPMAX=50
C       MEMORY LAYOUT AND RADIX -- also the mainline's, also unset by
C       INIT.  FINISH's "IADDC (PGINFO(DBPG,1),INEG16(DBBRK),J)" raises
C       loader error 26 when PGINFO is zero.
C
C         PAKFAC  host words per AP word.  FSLMLD takes PS as
C                 (CNT*PAKFAC)/4 and MD as (CNT*PAKFAC)/2 with CNT in
C                 host words, so a 16-bit host gives 1.
C         RADIX   .APO objects are octal -- manual 3.1, "numbers
C                 written as octal characters".
C         PSMAX   highest PS address, the PMAX command's value
C                 (manual 2.3.18); program store is 4K.
C         PGINFO(page,1) is the top of that MD page -- FINISH sizes the
C                 parameter passing area as PGINFO(DBPG,1)-DBBRK -- and
C                 MMAX's limit is 65534 (manual 2.3.17).
C
        PAKFAC=1
        RADIX=8
        LRADIX=8
        IRADIX=8
        PSMAX=4095
        MDLOW=0
        PSLOW=0
        PSBRK=0
        DBBRK=0
        DBPG=1
C       65534 IS NOT A VALID INTEGER*2 LITERAL -- "VALUE OF CONSTANT NOT
C       IN RANGE".  The recovered code does unsigned 16-bit arithmetic
C       through IADD16/IADDC/INEG16, where 65534 is the bit pattern -2.
        PGINFO(1,1)=-2
        PGINFO(1,2)=0
        MXDATA=20000
        LMLDSW=0
C
C       INIT'S FIRST ARGUMENT MUST BE 1, NOT 0.  ITS BODY IS
C
C           IF (FLAG1 .EQ. 0) GOTO 180
C           CALL RMVCS (SLMFIL,1,-1)
C           ...
C           SCLUN(1)=1
C           IF (INFILE (7,SCLUN,CLUN) .NE. 0) GOTO 90000
C           SCLUN2(1)=2
C
C       so FLAG1=0 SKIPS opening the two code scratch files and skips
C       clearing the output file names.  The INI command reaches INIT as
C       "CALL INIT (1,0)", and startup wants exactly that same state.
C       With 0 the loader ran to completion and wrote a load module that
C       was nothing but its FORTRAN wrapper -- every staged instruction
C       had gone to a unit that was never opened.
C
        CALL INIT (1,0)
C
C       THE DATA BLOCK SCRATCH FILE.  LOAD1 WRITES ON IT --
C       "DBLUNX=DBLUN+LUNMAP" -- AND REWINDS IT -- "INFILE (6,ID,DBLUN)"
C       -- BUT NO RECOVERED MODULE EVER OPENS IT, THE SAME PATTERN AS
C       THE FILE NUMBERS AND THE TABLE LIMITS.  INIT OPENS ONLY THE TWO
C       CODE SCRATCH FILES, SO THIS THIRD ONE IS THE MAINLINE'S.
C       WITHOUT IT RSX INVENTS FOR013.DAT.
C
        DBSCR(1)=3
        IZ=INFILE (7,DBSCR,DBLUN)
C
C       COMMAND INPUT.  INIT OPENS THE SCRATCH FILE -- ITS
C       "INFILE (7,SCLUN,CLUN)", OP 7 BEING AN OPEN -- BUT IT DOES NOT
C       SET ILUN, THE COMMAND INPUT UNIT.  THAT IS THE MAINLINE'S JOB,
C       AND LEAVING IT ZERO MAKES THE FIRST RDLIN FAIL WITH A FORTRAN
C       OTS ERROR BEFORE ANY COMMAND IS READ.
C
C       ILUN IS A FILE NUMBER, NOT A FORTRAN UNIT, AND A NEGATIVE ONE
C       MEANS THE TERMINAL.  RDLIN'S OWN CODE SETTLES IT:
C
C           LU = LUN
C           IF (LUN .GT. 0) LU = LUN + 7      FILE NUMBER -> UNIT
C           IF (LUN .GE. 0) GO TO 20
C           READ (5,...)                      LUN < 0: THE TERMINAL
C       20  READ (LU,...)
C
C       The recovered code uses the convention the same way -- COMAND's
C       "CALL WRTLIN (CMNDS(PC),-1,-1)" writes to the terminal.  ILUN=5
C       read unit 12, which nothing had opened, so every RDLIN returned
C       end of file at once.  The INPUT command replaces this with a
C       real file number; manual 2.3.1: "an end-of-file causes commands
C       to be read from the terminal again".
C
        ILUN=-1
C
C       ITTO IS A REAL FORTRAN UNIT: the -1 convention is interpreted by
C       FDUTIL's RDLIN and WRTLIN, not by a raw WRITE, and WRITE to unit
C       -1 gives "INVALID LOGICAL UNIT NUMBER".  WRTLIN itself writes to
C       unit 5 for a negative LUN, so 5 is the terminal here.  Nothing
C       in the recovered 40 references ITTO -- it belongs to the modules
C       that were lost.
C
        ITTO=5
C
C       THE STARTUP DIALOGUE IS MANUAL 2.2: LOD100 ANNOUNCES ITSELF AND
C       THEN PROMPTS WITH AN ASTERISK, AND "AFTER LOD100 PROCESSES EACH
C       COMMAND, IT DISPLAYS THE ASTERISK TO INDICATE THAT ANOTHER
C       COMMAND CAN BE ENTERED".
C
        WRITE (ITTO,9800)
9800    FORMAT (' LOD100  REL. 1.01 , RECONSTRUCTION')
C
C       COMMAND LOOP.
C
100     CONTINUE
        WRITE (ITTO,9810)
9810    FORMAT (' *')
        IPTR=1
        IRD=RDLIN (STR,ILUN,80)
        IF (IRD .LT. 0) GO TO 900
        IF (IRD .NE. 8285 .AND. STR(2) .NE. 8285) GO TO 110
C
C       END OF FILE ON THE COMMAND STREAM.  8285 IS FPS'S LEOF; SEE
C       FDUTIL'S RDLIN FOR WHY IT IS NOT -1.  LOADER 2.3.1 SAYS WHAT
C       TO DO WITH IT: "AN END-OF-FILE CAUSES COMMANDS TO BE READ
C       FROM THE TERMINAL AGAIN", AND ALSO THAT CONTROL GOES BACK TO
C       THE TERMINAL AND NOT TO ANY OUTER INPUT FILE, WHICH IS WHY
C       ONE IPTLUN IS ENOUGH.  ON THE TERMINAL ITSELF THERE IS
C       NOTHING TO FALL BACK TO, SO STOP.
C
        IF (ILUN .EQ. -1) GO TO 900
        IZ=INFILE (4,SFILE,IPTLUN)
        ILUN=-1
        GO TO 100
110     CONTINUE
C
C       MATCH ON AT MOST THREE CHARACTERS.  COMAND's own code:
C           LEN = MIN0 (MAXLEN,3)
C           IF (CMPSS(CMNDS(PC),STR,MIN0(CMNDS(PC),LEN)).EQ.0) ...
C       so it compares the shorter of the list entry and LEN, capped at
C       three -- which is why the list holds LO, MAP, LIN, INI, MAR.
C       Passing -1 makes LEN -1 and nothing ever matches.
C
        CMD=COMAND (0,STR,3)
C
C       STEP IPTR PAST THE COMMAND WORD.  The handlers parse their
C       arguments from IPTR onward -- LOAD does "CALL SKPBLK (STR,IPTR)"
C       then "EXTSS (STR,IPTR,SOFIL,30)" -- so with IPTR still at 1 they
C       extract the command itself.  That is why LOAD tried to open a
C       file called LOAD.  COMAND compares at most three characters but
C       the word may be longer, so skip non-blanks, then blanks.
C
        IPTR=1
        NCH=STR(1)
1050    IF (IPTR .GT. NCH) GO TO 1070
        IF (IAND16 (STR(IPTR+1),255) .EQ. 32) GO TO 1060
        IPTR=IPTR+1
        GO TO 1050
1060    CONTINUE
1070    CONTINUE
        IF (CMD .LT. 1 .OR. CMD .GT. 34) GO TO 800
        GO TO (1001,1002,1099,1099,1005,1006,1007,1008,1009,
     *         1099,1011,1012,1013,1014,1099,1099,1017,1018,
     *         1099,1020,1021,1022,1023,1024,1025,1099,1099,
     *         1028,1029,1099,1031,1032,1033,1034), CMD
C
C       LO -- LOAD.  FLAG=1 means "the file name is on this command
C       line": LOAD's own code is "IF (FLAG .EQ. 0) GOTO 1150", which
C       skips extracting SOFIL and opening it.  Passing 0 left OLUN
C       unopened and LOAD1 then read a closed unit.
1001    CALL LOAD (1,STR,IPTR,LIBFLG,LFFLG)
        GO TO 100
C       MAP
1002    CALL LOADMP
        GO TO 100
C       EX -- EXIT.  [M 2.3.25] "THIS COMMAND CLOSES ALL FILES AND
C       RETURNS CONTROL TO THE OPERATING SYSTEM.  IT ALSO INITIALIZES THE
C       REMAINING ENTRIES IN THE TASK OVERLAY TABLE, THE PARTITION TABLE,
C       AND THE READY QUEUE AND ALLOCATES SPACE FOR THE PARAMETER PASSING
C       AREA."  THAT IS FINISH'S JOB.  EXIT DOES **NOT** LINK.
C
C       THIS USED TO CALL LINKS FIRST, SO A JOB WITH AN EXPLICIT LINK
C       LINKED TWICE AND WROTE TWO LOAD MODULES -- THE SECOND HOLDING A
C       DUPLICATE OVERLAY TABLE AND INFO RECORD.
C
C       LINK IS MANDATORY: BOTH DOCUMENTED SEQUENCES END "LINK" THEN
C       "EXIT" -- 2.4 FOR A SINGLE-LEVEL JOB AND 2.5 FOR A MULTI-LEVEL
C       ONE -- AND 2.3.23 IS WHAT WRITES THE LOAD MODULE.  A COMMAND FILE
C       THAT OMITS LINK NOW CORRECTLY PRODUCES NOTHING, WHICH IS WHAT THE
C       REAL LOD100 DOES.
1006    CALL FINISH
        GO TO 900
C       F -- FORCE
1007    CALL FORCE (STR,IPTR,SYM)
        GO TO 100
C       OU -- OUTPUT
1008    CALL OUTPUT
        GO TO 100
C       C -- CALL
1009    CALL CALLS
        GO TO 100
C       LIN -- LINK.  COMMAND 5 IN COMAND'S LIST, AND IT WAS ROUTED TO
C       1099, "UNDOCUMENTED COMMAND -- NO RECOVERED HANDLER", WHICH
C       REPORTS ERRMES(1) -- THE SAME CODE THAT MEANS READ ERROR
C       EVERYWHERE ELSE.  SO AN OVERLAID JOB FAILED AT ITS LINK COMMAND
C       WITH A MISLEADING "ERROR 1" AND THE FOLLOWING EXIT WAS THEN
C       REJECTED AS OUT OF ORDER.
C
C       LINK IS DOCUMENTED, [M 2.3.23]: "THIS COMMAND CAUSES OBJECT CODE
C       TO BE LINKED, RELOCATED, AND WRITTEN TO THE LOAD MODULE.  SPACE
C       IS ALSO ALLOCATED FOR THE TCB (IF TASKS ARE LOADED), THE OVERLAY
C       MAP, AND ANY LOCAL DATA BLOCKS..."  IT TAKES NO ARGUMENT, AND
C       EVERY LOAD SEQUENCE IN 2.7.1 AND 2.7.2 ENDS WITH IT.  LINKS IS
C       FPS'S OWN RECOVERED ROUTINE AND DOES EXACTLY THAT.
C
C       A FLAT JOB NEVER NOTICED: IT REACHES THE SAME CODE THROUGH EXIT.
C
1005    CALL LINKS
        GO TO 100
C       OV -- OVERLAY
1011    CALL OVLY (STR,IPTR,IRADIX,LNKFLG,SYM)
        GO TO 100
C       N -- NOLOAD
1012    CALL NOLOAD
        GO TO 100
C       LM -- LMID
1013    CONTINUE
        GO TO 100
C       PP -- PPA
1014    CONTINUE
        GO TO 100
C       INI -- INIT
1017    CALL INIT (1,0)
        GO TO 100
C       LIB
1018    CALL LIB
        GO TO 100
C       MD -- MDOFF
1020    CALL MDOFF
        GO TO 100
C       PS -- PSOFF
1021    CALL PSOFF
        GO TO 100
C       PM -- PMAX
1022    CONTINUE
        GO TO 100
C       MM -- MMAX
1023    CALL MMAX
        GO TO 100
C       R -- RADIX
1024    CONTINUE
        GO TO 100
C       INP -- INPUT
1025    CALL INPUT
        GO TO 100
C       TR -- TREE
1028    CALL TREE (STR,IPTR,IRADIX,0,SYM)
        GO TO 100
C       MO -- MODE.  [M 2.3.5] "THIS COMMAND NOTIFIES LOD100 THAT FPS-100
C       SUPERVISOR TASKS ARE TO BE LOADED DURING THE SESSION.  LOD100
C       ADJUSTS ITS INTERNAL FLAGS SO THAT THE COMMANDS WHICH FOLLOW
C       EXECUTE TASK BUILDING CODE WHENEVER NECESSARY."  THAT FLAG IS
C       TASKFL, WHICH WAS OTHERWISE ONLY EVER SET BY AN OBJECT $TASK
C       BLOCK THROUGH TASKY -- SO "MODE TASK" DID NOTHING AT ALL AND AN
C       FTN100 TASK JOB BUILT AS IF IT HELD NO TASKS.  THE ONLY OPERAND
C       THE MANUAL GIVES IS "TASK".
1029    CONTINUE
        TASKFL=.TRUE.
        TSKFL=.TRUE.
C
C       AND IT MUST CLEAR OVID.  LOAD1 SETS "OVID=-1" AT LABEL 1040 --
C       "THIS LOAD MODULE DOES NOT CONTAIN OVERLAYS" -- ON EVERY LOAD
C       MADE WHILE OVFLG IS 0, WHICH IS EXACTLY WHAT THE SUPERVISOR'S
C       FLAT LOAD DOES; AND OVLY'S THIRD LINE IS
C       "IF (OVID .EQ. -1) GOTO 99999", SO EVERY LATER OV COMMAND IS
C       SILENTLY IGNORED AND CUROV STAYS 0.  LINK THEN REPORTS ERROR 22.
C
C       OVID IS ASSIGNED IN EXACTLY THREE PLACES: INIT SETS 0, LOAD1
C       SETS -1, OVLY SETS TOVID.  THE DOCUMENTED SUPERVISOR SEQUENCE
C       [M 2.7.1] IS "LOAD ... LINK / MODE TASK / PSOFF / TREE / OV /
C       LOAD taskfile / LINK" -- TWO LINKS INTO ONE LOAD MODULE WITH NO
C       INIT, AND [M 2.6] SAYS INIT IS FOR SEPARATE LOAD MODULES AND
C       THAT THOSE "CANNOT BE USED WITH THE FPS-100 SUPERVISOR".  LINKS
C       IS FPS'S OWN AND TOUCHES NEITHER FLAG.  SO THE ONLY PLACE LEFT
C       FOR THE RESET IS HERE, IN THE LOST MAINLINE'S MODE HANDLER --
C       WHICH FITS WHAT 2.3.5 SAYS IT DOES: "LOD100 ADJUSTS ITS INTERNAL
C       FLAGS SO THAT THE COMMANDS WHICH FOLLOW EXECUTE TASK BUILDING
C       CODE".
C
        OVID=0
        GO TO 100
C       TA -- TASK
1031    CALL TASKY (STR,IPTR,0,IRADIX)
        GO TO 100
C       PR -- PRI
1032    CONTINUE
        GO TO 100
C       MAR -- MARK
1033    CALL MARK
        GO TO 100
C       PU -- PURGE
1034    CALL PURGE
        GO TO 100
C
C       UNDOCUMENTED COMMAND -- PRESENT IN COMAND'S LIST, NO RECOVERED
C       HANDLER AND NO SPECIFICATION.  SAY SO.
C
1099    CONTINUE
        CALL ERRMES (1)
        GO TO 100
C
C       UNRECOGNISED COMMAND
C
800     CONTINUE
        CALL ERRMES (1)
        GO TO 100
900     CONTINUE
        STOP
        END
