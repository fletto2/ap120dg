C+++ WRTLM
C****** WRTLM = WRITE A LOAD MODULE RECORD = RECONSTRUCTION
C
C       NOT RECOVERED FPS SOURCE.  WRITTEN TO THE INTERFACE THE
C       RECOVERED MODULES CALL, AND TO THE RECORD LAYOUTS THE LOD100
C       REFERENCE MANUAL SECTION 4.2 DOCUMENTS.
C
C       EVERY BLOCK IS AN EIGHT-WORD HEADER, OPTIONALLY FOLLOWED BY
C       DATA RECORDS (MANUAL 4.2).  MODE SELECTS WHICH:
C
C         MODE=0   HEADER.  ITYPE IS THE BLOCK TYPE AND IW3..IW9 ARE
C                  ITS REMAINING WORDS, IN ORDER:
C                    (0) CODE     0 COUNT ADDR PG DEST 0 0 0
C                    (1) DATA     1 COUNT 0 PG 0 0 0 0
C                    (2) INFO     2 PPAAD PPASZ LMID OVLEN OVADDR 0 0
C                    (3) END      3 0 0 0 0 0 0 0    LOGICAL
C                                 3 1 0 0 0 0 0 0    TERMINATING
C         MODE=1   DATA RECORD OF A DATA BLOCK:
C                    ITYPE RC ADDR 0 VALUE-A VALUE-B VALUE-C VALUE-D
C                  ITYPE IS 1 16-BIT INTEGER, 2 SINGLE PRECISION HOST
C                  REAL, 4 DOUBLE PRECISION INTEGER (38-BIT).  RA/RB
C                  CARRY THE TYPE 2 VALUE.
C
C       THE WORDS GO OUT THROUGH WRTBR, WHICH IS THE ONLY WORD EMITTER,
C       SO NO MODULE OUTSIDE FPS'S OWN SET IS INVENTED.
C
        SUBROUTINE WRTLM (MODE,ITYPE,IW3,IW4,IW5,IW6,IW7,IW8,IW9,RA,RB)
C
        INTEGER MODE,ITYPE,IW3,IW4,IW5,IW6,IW7,IW8,IW9
        REAL RA,RB
        INTEGER REC(8),DUMMY,I
        REAL RVAL(2)
        EQUIVALENCE (RVAL(1),REC(5))
        COMMON /LDTABS/ PRGDTA (503),PRGMAX,ENTDTA(503),ENTMAX,         LDTABS
     *                EXTDTA(283),EXTMAX,EX1PTR,                        LDTABS
     *                OLUN,RADIX,CLUN,MDLOW,PSLOW,                      LDTABS
     *                PSBRK,DBDTA1(203),DB1MAX,DBDTA2(150,2),DB2MAX,    LDTABS
     *                DB2PTR,OVDTA(16,9),OVPTR,OVMAX,LRADIX,PSMAX,      LDTABS
     *                DBST,DBBRK,DB0PTR,DB0MAX,DBDTA0(70),              LDTABS
     *                EXTDT1(200),                                      LDTABS
     *                EXTMX1,ENTDT1(100),ENTMX1,ENTPT1,LMLUN,           LDTABS
     *                PARDTA(100),PARMAX,PARPTR,FLUN,VARSIZ(3),         LDTABS
     *                CNTMAX,PARADR,MAXPAR,OVID,OVFLG,LMID,             LDTABS
     *                OVPG,DBPG,BUFFER(200),BUFSIZ,PAKFAC,              LDTABS
     *                DBLUN,EKOFLG,EKOLUN,CLUNS(2),CCLUN,CUROV,         LDTABS
     *                NOTUS1,NOTUS2,NOTUS3,LUNMAP,OFFSET,EXTHST,M65536  LDTABS
        COMMON /LDTABS/ SFFIL(31),SOFIL(31),SLMFIL(31),PGINFO(16,2)     LDTABS
        COMMON /LDTABS/ SCLUN(16),SCLUN2(16),CLUN2                      LDTABS
        COMMON /LDTABS/ PPASZ,OTOFLG,OVLEVL,CALFLG,CMPFLG,RSTRCT,       LDTABS
     *                  PSHLD,OV1FLG,MAPLUN,NAMLUN,LP2LUN,SLP2NM(16)    LDTABS
        COMMON /LDTABS/FLMLUN,FLMFIL,LMLDSW,MXDATA,SUBCNT,              LDTABS
     *               CODPTR,LMHDRC                                      LDTABS
        INTEGER PRGDTA,PRGMAX,ENTDTA,ENTMAX,                            LDTABS
     *          EXTDTA,EXTMAX,EX1PTR,                                   LDTABS
     *          OLUN,RADIX,CLUN,MDLOW,PSLOW,                            LDTABS
     *          PSBRK,DBDTA1,DB1MAX,DBDTA2,DB2MAX,                      LDTABS
     *          DB2PTR,OVDTA,OVPTR,OVMAX,LRADIX,PSMAX,                  LDTABS
     *          DBST,DBBRK,DB0PTR,DB0MAX,DBDTA0,EXTDT1,                 LDTABS
     *          EXTMX1,ENTDT1,ENTMX1,ENTPT1,LMLUN,                      LDTABS
     *          PARDTA,PARMAX,PARPTR,FLUN,VARSIZ,                       LDTABS
     *          CNTMAX,PARADR,MAXPAR,OVID,OVFLG,LMID,                   LDTABS
     *          OVPG,DBPG,BUFFER,BUFSIZ,PAKFAC,                         LDTABS
     *          DBLUN,EKOFLG,EKOLUN,CLUNS,CCLUN,CUROV,                  LDTABS
     *          NOTUS1,NOTUS2,NOTUS3,LUNMAP,OFFSET,EXTHST,M65536        LDTABS
        INTEGER SFFIL,SOFIL,SLMFIL,PGINFO                               LDTABS
        INTEGER SCLUN,SCLUN2,CLUN2                                      LDTABS
        INTEGER PPASZ,OTOFLG,OVLEVL,CALFLG,CMPFLG,RSTRCT,PSHLD,OV1FLG   LDTABS
        INTEGER MAPLUN,NAMLUN,LP2LUN,SLP2NM                             LDTABS
        INTEGER FLMLUN,FLMFIL(31),LMLDSW,MXDATA,SUBCNT,                 LDTABS
     *           CODPTR,LMHDRC(8)                                       LDTABS
C
        REC(1)=ITYPE
        REC(2)=IW3
        REC(3)=IW4
        REC(4)=IW5
        REC(5)=IW6
        REC(6)=IW7
        REC(7)=IW8
        REC(8)=IW9
        IF (MODE .NE. 1) GO TO 100
C
C       A DATA RECORD OF TYPE 2 CARRIES A HOST REAL, NOT INTEGERS.
C       MANUAL 4.2.2: TYPE 2 IS "SINGLE PRECISION HOST REAL".
C
        IF (ITYPE .NE. 2) GO TO 100
        RVAL(1)=RA
        RVAL(2)=RB
100     CONTINUE
C
C       KEEP THE LAST HEADER.  MANUAL 4.2.3: "THERE MAY BE MULTIPLE
C       OCCURRENCES OF THE INFORMATION BLOCK HEADER.  ONLY THE LAST ONE
C       IS MEANINGFUL."
C
        IF (MODE .NE. 0) GO TO 200
        DO 150 I=1,8
        LMHDRC(I)=REC(I)
150     CONTINUE
200     CONTINUE
        CALL WRTBR (0,REC,8,1,0,DUMMY,DUMMY)
        RETURN
        END
C+++ WRTBR
C****** WRTBR = WRITE A BLOCK RECORD = RECONSTRUCTION
C
C       NOT RECOVERED FPS SOURCE.  THE RECOVERED MODULES CALL IT AS
C         CALL WRTBR (1,BUFFER,J-1,1,0,DUMMY,DUMMY)
C       to emit ILEN words of IBUF as a data record, and WRTLM calls it
C       with IFLAG=0 to emit an eight-word header.
C
C       MANUAL 4.2.5: THE DEFAULT LOAD MODULE IS "STORED IN THE FORM OF
C       A FORTRAN SUBROUTINE CONSISTING PRIMARILY OF DATA STATEMENTS",
C       AND /D ON THE OUTPUT COMMAND GIVES A BINARY ONE INSTEAD.  THE
C       MANUAL ALSO WARNS THAT SOME COMPILERS LIMIT THE NUMBER OF DATA
C       STATEMENTS, IN WHICH CASE "LOD100 CREATES MORE THAN ONE
C       SUBROUTINE IN THE LOAD MODULE" -- HENCE MXDATA AND SUBCNT.
C
        SUBROUTINE WRTBR (IFLAG,IBUF,ILEN,IN,IZ,ID1,ID2)
C
        INTEGER IFLAG,IBUF(1),ILEN,IN,IZ,ID1,ID2
        INTEGER I,J
        INTEGER LMBUF(4),LMIDX(4),LMPTR,LMLUNX
        COMMON /LDTABS/ PRGDTA (503),PRGMAX,ENTDTA(503),ENTMAX,         LDTABS
     *                EXTDTA(283),EXTMAX,EX1PTR,                        LDTABS
     *                OLUN,RADIX,CLUN,MDLOW,PSLOW,                      LDTABS
     *                PSBRK,DBDTA1(203),DB1MAX,DBDTA2(150,2),DB2MAX,    LDTABS
     *                DB2PTR,OVDTA(16,9),OVPTR,OVMAX,LRADIX,PSMAX,      LDTABS
     *                DBST,DBBRK,DB0PTR,DB0MAX,DBDTA0(70),              LDTABS
     *                EXTDT1(200),                                      LDTABS
     *                EXTMX1,ENTDT1(100),ENTMX1,ENTPT1,LMLUN,           LDTABS
     *                PARDTA(100),PARMAX,PARPTR,FLUN,VARSIZ(3),         LDTABS
     *                CNTMAX,PARADR,MAXPAR,OVID,OVFLG,LMID,             LDTABS
     *                OVPG,DBPG,BUFFER(200),BUFSIZ,PAKFAC,              LDTABS
     *                DBLUN,EKOFLG,EKOLUN,CLUNS(2),CCLUN,CUROV,         LDTABS
     *                NOTUS1,NOTUS2,NOTUS3,LUNMAP,OFFSET,EXTHST,M65536  LDTABS
        COMMON /LDTABS/ SFFIL(31),SOFIL(31),SLMFIL(31),PGINFO(16,2)     LDTABS
        COMMON /LDTABS/ SCLUN(16),SCLUN2(16),CLUN2                      LDTABS
        COMMON /LDTABS/ PPASZ,OTOFLG,OVLEVL,CALFLG,CMPFLG,RSTRCT,       LDTABS
     *                  PSHLD,OV1FLG,MAPLUN,NAMLUN,LP2LUN,SLP2NM(16)    LDTABS
        COMMON /LDTABS/FLMLUN,FLMFIL,LMLDSW,MXDATA,SUBCNT,              LDTABS
     *               CODPTR,LMHDRC                                      LDTABS
        INTEGER PRGDTA,PRGMAX,ENTDTA,ENTMAX,                            LDTABS
     *          EXTDTA,EXTMAX,EX1PTR,                                   LDTABS
     *          OLUN,RADIX,CLUN,MDLOW,PSLOW,                            LDTABS
     *          PSBRK,DBDTA1,DB1MAX,DBDTA2,DB2MAX,                      LDTABS
     *          DB2PTR,OVDTA,OVPTR,OVMAX,LRADIX,PSMAX,                  LDTABS
     *          DBST,DBBRK,DB0PTR,DB0MAX,DBDTA0,EXTDT1,                 LDTABS
     *          EXTMX1,ENTDT1,ENTMX1,ENTPT1,LMLUN,                      LDTABS
     *          PARDTA,PARMAX,PARPTR,FLUN,VARSIZ,                       LDTABS
     *          CNTMAX,PARADR,MAXPAR,OVID,OVFLG,LMID,                   LDTABS
     *          OVPG,DBPG,BUFFER,BUFSIZ,PAKFAC,                         LDTABS
     *          DBLUN,EKOFLG,EKOLUN,CLUNS,CCLUN,CUROV,                  LDTABS
     *          NOTUS1,NOTUS2,NOTUS3,LUNMAP,OFFSET,EXTHST,M65536        LDTABS
        INTEGER SFFIL,SOFIL,SLMFIL,PGINFO                               LDTABS
        INTEGER SCLUN,SCLUN2,CLUN2                                      LDTABS
        INTEGER PPASZ,OTOFLG,OVLEVL,CALFLG,CMPFLG,RSTRCT,PSHLD,OV1FLG   LDTABS
        INTEGER MAPLUN,NAMLUN,LP2LUN,SLP2NM                             LDTABS
        INTEGER FLMLUN,FLMFIL(31),LMLDSW,MXDATA,SUBCNT,                 LDTABS
     *           CODPTR,LMHDRC(8)                                       LDTABS
        DATA LMPTR/1/
C
        IF (ILEN .LE. 0) RETURN
C
C       THE UNIT IS FLMLUN PLUS LUNMAP.  FLMLUN IS A FILE NUMBER, AND
C       FDUTIL'S INFILE OPENED IT ON FILE+7; WRITING ON THE BARE FILE
C       NUMBER LANDS ON UNIT 5, THE TERMINAL, AND THE WHOLE LOAD MODULE
C       IS TYPED AT THE CONSOLE INSTEAD OF BEING WRITTEN.  THE RECOVERED
C       CODE MAKES THE BIAS EXPLICIT WHEREVER IT WRITES -- FINISH HAS
C       "LUNX=FLUN+LUNMAP", LOAD1 HAS "CLUNX=CLUN+LUNMAP" AND
C       "DBLUNX=DBLUN+LUNMAP".
C
        LMLUNX=FLMLUN+LUNMAP
        DO 200 I=1,ILEN
C
C       BINARY LOAD MODULE (/D ON THE OUTPUT COMMAND): THE WORD GOES
C       OUT AS IT STANDS.
C
        IF (LMLDSW .NE. 1) GO TO 50
        WRITE (LMLUNX,900) IBUF(I)
900     FORMAT (I8)
        CODPTR=CODPTR+1
        GO TO 200
C
C       HOST RESIDENT: A FORTRAN SUBROUTINE OF DATA STATEMENTS.  START
C       A FRESH ONE EVERY MXDATA WORDS -- MANUAL 4.2.5 WARNS THAT SOME
C       COMPILERS LIMIT THE NUMBER OF DATA STATEMENTS, IN WHICH CASE
C       "LOD100 CREATES MORE THAN ONE SUBROUTINE IN THE LOAD MODULE".
C
50      CONTINUE
        IF (CODPTR .NE. 0) GO TO 60
        SUBCNT=SUBCNT+1
        WRITE (LMLUNX,910) SUBCNT
910     FORMAT (6X,'SUBROUTINE L ',I3)
        WRITE (LMLUNX,920) MXDATA
920     FORMAT (6X,'INTEGER CODE(',I6,')')
60      CONTINUE
        CODPTR=CODPTR+1
        LMBUF(LMPTR)=IBUF(I)
        LMIDX(LMPTR)=CODPTR
        LMPTR=LMPTR+1
        IF (LMPTR .LE. 4) GO TO 100
        WRITE (LMLUNX,930) (LMIDX(J),J=1,4)
930     FORMAT (6X,'DATA CODE(',I6,'),CODE(',I6,'),CODE(',I6,
     *          '),CODE(',I6,')/')
        WRITE (LMLUNX,940) (LMBUF(J),J=1,4)
940     FORMAT (5X,'*',I7,',',I7,',',I7,',',I7,'/')
        LMPTR=1
100     CONTINUE
        IF (CODPTR .LT. MXDATA) GO TO 200
        WRITE (LMLUNX,950)
950     FORMAT (6X,'RETURN'/6X,'END')
        CODPTR=0
200     CONTINUE
        RETURN
        END
