C+++ TREE
C****** TREE = PARSE THE OVERLAY STRUCTURE = RECONSTRUCTION
C
C       NOT RECOVERED FPS SOURCE.  WRITTEN TO THE INTERFACE THE
C       RECOVERED MODULES CALL -- LOAD1 DOES
C           CALL TREE(STRTRE,IPTR,RADIX,0,SYM)
C       -- AND TO THE STRUCTURE THE LOD100 MANUAL 2.3.8 DEFINES:
C
C           TREE ((1(2)(3))(4)(5))
C
C       "A LEFT PARENTHESIS INDICATES THE START OF A NEW OVERLAY LEVEL;
C       A RIGHT PARENTHESIS RESCINDS A LEVEL.  OVERLAY NUMBERS BETWEEN
C       PARENTHESES INDICATE THE OVERLAY SEGMENTS THAT ARE CONTAINED IN
C       A PARTICULAR OVERLAY LEVEL."
C
C       THE FIELDS IT MUST FILL ARE NOT GUESSED.  LOADMP PRINTS THE
C       OVERLAY MAP AS
C
C            ID  PG  MDADDR     LEN  PSADDR  LEV BRL BRR
C
C       AND ITS RPLIS CALLS BIND EACH COLUMN TO A FIELD:
C           ID  = OVDTA(I,1)
C           PG  = OVDTA(I,6) .AND. 15
C           LEV = OVDTA(I,6) / 16
C           BRL = OVDTA(I,5) .AND. 255
C           BRR = OVDTA(I,5) / 256
C       OVDTA COLUMNS 1 AND 5 ARE READ BY ENDLNK AND LOADMP AND WRITTEN
C       NOWHERE IN THE RECOVERED 40 -- THEY ARE PRECISELY WHAT THIS
C       ROUTINE OWES.  OVLY LATER ORS THE PAGE INTO COLUMN 6.
C
C       BRL/BRR ARE A FIRST-CHILD / NEXT-SIBLING ENCODING: BRL IS THE
C       FIRST SEGMENT ONE LEVEL DOWN, BRR THE NEXT SEGMENT AT THE SAME
C       LEVEL.  THAT IS WHAT LETS A GENERAL OVERLAY TREE LIVE IN TWO
C       BYTES PER NODE.
C
        SUBROUTINE TREE (STR,IPTR,IRADIX,LEVEL,SYM)
C
        INTEGER STR(1),IPTR,IRADIX,LEVEL,SYM(1)
        INTEGER LEV,ICH,IVAL,I,IPAR,LAST(16),PREV(16),STOI,EXTTOK
        INTEGER LPAR,RPAR
        COMMON /LDTABS/ PRGDTA (503),PRGMAX,ENTDTA(503),ENTMAX,         LDTABS
     *                EXTDTA(283),EXTMAX,EX1PTR,                        LDTABS
     *                OLUN,RADIX,CLUN,MDLOW,PSLOW,                      LDTABS
     *                PSBRK,DBDTA1(203),DB1MAX,DBDTA2(150,2),DB2MAX,    LDTABS
     *                DB2PTR,OVDTA(16,9),OVPTR,OVMAX,LRADIX,PSMAX,      LDTABS
     *                DBST,DBBRK,DB0PTR,DB0MAX,DBDTA0(70),              LDTABS
     *                EXTDT1(200),                                      LDTABS
     *                EXTMX1,ENTDT1(100),ENTMX1,ENTPT1,LMLUN,           LDTABS
     *                PARDTA(100),PARMAX,PARPTR,FLUN,VARSIZ(3),         LDTABS
     *                CNTMAX,PARADR,MAXPAR,OVID,OVFLG,LMID,             LDTABS
     *                OVPG,DBPG,BUFFER(200),BUFSIZ,PAKFAC,              LDTABS
     *                DBLUN,EKOFLG,EKOLUN,CLUNS(2),CCLUN,CUROV,         LDTABS
     *                NOTUS1,NOTUS2,NOTUS3,LUNMAP,OFFSET,EXTHST,M65536  LDTABS
        COMMON /LDTABS/ SFFIL(31),SOFIL(31),SLMFIL(31),PGINFO(16,2)     LDTABS
        COMMON /LDTABS/ SCLUN(16),SCLUN2(16),CLUN2                      LDTABS
        COMMON /LDTABS/ PPASZ,OTOFLG,OVLEVL,CALFLG,CMPFLG,RSTRCT,       LDTABS
     *                  PSHLD,OV1FLG,MAPLUN,NAMLUN,LP2LUN,SLP2NM(16)    LDTABS
        COMMON /LDTABS/FLMLUN,FLMFIL,LMLDSW,MXDATA,SUBCNT,              LDTABS
     *               CODPTR,LMHDRC                                      LDTABS
        INTEGER PRGDTA,PRGMAX,ENTDTA,ENTMAX,                            LDTABS
     *          EXTDTA,EXTMAX,EX1PTR,                                   LDTABS
     *          OLUN,RADIX,CLUN,MDLOW,PSLOW,                            LDTABS
     *          PSBRK,DBDTA1,DB1MAX,DBDTA2,DB2MAX,                      LDTABS
     *          DB2PTR,OVDTA,OVPTR,OVMAX,LRADIX,PSMAX,                  LDTABS
     *          DBST,DBBRK,DB0PTR,DB0MAX,DBDTA0,EXTDT1,                 LDTABS
     *          EXTMX1,ENTDT1,ENTMX1,ENTPT1,LMLUN,                      LDTABS
     *          PARDTA,PARMAX,PARPTR,FLUN,VARSIZ,                       LDTABS
     *          CNTMAX,PARADR,MAXPAR,OVID,OVFLG,LMID,                   LDTABS
     *          OVPG,DBPG,BUFFER,BUFSIZ,PAKFAC,                         LDTABS
     *          DBLUN,EKOFLG,EKOLUN,CLUNS,CCLUN,CUROV,                  LDTABS
     *          NOTUS1,NOTUS2,NOTUS3,LUNMAP,OFFSET,EXTHST,M65536        LDTABS
        INTEGER SFFIL,SOFIL,SLMFIL,PGINFO                               LDTABS
        INTEGER SCLUN,SCLUN2,CLUN2                                      LDTABS
        INTEGER PPASZ,OTOFLG,OVLEVL,CALFLG,CMPFLG,RSTRCT,PSHLD,OV1FLG   LDTABS
        INTEGER MAPLUN,NAMLUN,LP2LUN,SLP2NM                             LDTABS
        INTEGER FLMLUN,FLMFIL(31),LMLDSW,MXDATA,SUBCNT,                 LDTABS
     *           CODPTR,LMHDRC(8)                                       LDTABS
        DATA LPAR/1H(/,RPAR/1H)/
C
C
C       EACH TREE COMMAND DECLARES A COMPLETE STRUCTURE, SO IT STARTS A
C       NEW ONE.  [M 2.3.8]: THE PARAMETER "SPECIFIES THE COMPLETE
C       OVERLAY STRUCTURE OF THE LOAD MODULE", AND [M 2.7.2] ISSUES ONE
C       TREE PER TASK -- "LINK / PSOFF nnn / TREE / OV n / TASK id" FOR
C       EACH ADDITIONAL TASK.
C
C       APPENDING INSTEAD LEFT TWO TREES IN ONE OVDTA, AND OVLY'S
C       ORDERING WALK ONLY FOLLOWS THE FIRST ONE'S SUCCESSOR CHAIN: AT
C       LABEL 3240 IT CLIMBS TO THE PARENT, FINDS 0, AND TAKES
C       "IF (LNKFLG .EQ. 0) GOTO 90060" -- ERROR 12, BAD OR MISSING
C       PARAMETER -- ON THE SECOND TASK'S FIRST OV.  A PROBE THERE GAVE
C       IV=2, OVPTR=2, OVDTA(1,1)=1, OVDTA(2,1)=2: THE SEGMENT WAS FOUND,
C       IT WAS THE SUCCESSION THAT FAILED.
C
C       RESETTING IS SAFE BECAUSE EACH TASK'S MAP IS EMITTED AT ITS OWN
C       LINK, BEFORE THE NEXT TREE RUNS, AND THE ACCUMULATED MAP ENTRIES
C       LIVE IN OVPDTA, NOT OVDTA.  CUROV AND OVID GO BACK TO 0 SO THE
C       FIRST OV OF THE NEW TREE IS IN ORDER.
C
        IF (LEVEL .EQ. 0) OVPTR=0
        IF (LEVEL .EQ. 0) CUROV=0
        IF (LEVEL .EQ. 0) OVID=0
        LEV=LEVEL
        DO 10 I=1,16
        LAST(I)=0
        PREV(I)=0
10      CONTINUE
C
100     CONTINUE
        IF (IPTR .GT. STR(1)) GO TO 900
        ICH=STR(IPTR+1)
        IPTR=IPTR+1
        IF (ICH .EQ. LPAR) GO TO 200
        IF (ICH .EQ. RPAR) GO TO 300
        IF (ICH .LT. 1H0 .OR. ICH .GT. 1H9) GO TO 100
C
C       AN OVERLAY NUMBER.  BACK UP AND TAKE THE WHOLE TOKEN.
C
        IPTR=IPTR-1
        IF (EXTTOK (SYM,6,STR,IPTR,IPTR,IRADIX) .EQ. 0) GO TO 900
        IVAL=STOI (SYM,IRADIX)
        IF (OVPTR+1 .GT. OVMAX) GO TO 800
        OVPTR=OVPTR+1
C
C       DECLARING A SEGMENT MEANS WE ARE BUILDING OVERLAYS.  OVFLG IS
C       READ IN EIGHT PLACES AND SET IN EXACTLY ONE -- INIT'S OVFLG=0 --
C       SO LIKE LUNMAP, IPTLUN, CMPFLG AND PARMAX IT BELONGS TO THE LOST
C       MAINLINE, AND TREE IS WHERE IT IS RAISED: THE MANUAL HAS TREE
C       ENTERED BEFORE ANY OVERLAY COMMAND, AND LOAD1 SAYS "IF OVFLG=1
C       AND OVID=0 WE ARE BUILDING OVERLAYS BUT TRYING TO LOAD W/O
C       HAVING FIRST GIVEN AN OV COMMAND", WHICH IS EXACTLY THE STATE
C       TREE MUST LEAVE BEHIND (INIT ALREADY SETS OVID=0).
C
C       LEFT AT 0 IT DISABLES THE WHOLE OVERLAY PATH: LOAD1 TAKES
C       OVID=-1 "THIS LOAD MODULE DOES NOT CONTAIN OVERLAYS" AND SKIPS
C       RECORDING EACH SEGMENT'S PS LENGTH IN OVDTA(CUROV,4), INIT NEVER
C       OPENS THE SECOND CODE SCRATCH (SCLUN2/CLUN2 ARE GATED ON IT),
C       AND LINKUP IS ALWAYS CALLED AS LINKUP (OVFLG,...) -- DEST=0.
C
        OVFLG=1
        OVDTA(OVPTR,1)=IVAL
        OVDTA(OVPTR,5)=0
C
C       OVDTA(,6) IS (PARENT INDEX << 4) | MD PAGE -- NOT THE LEVEL.
C       OVLY WALKS THE TREE UPWARDS WITH IT AT LABEL 3240:
C
C           3240 IV2=IRSH16 (OVDTA(IV2,6),4)
C                IF (IV2 .NE. 0) GOTO 3245
C           3245 RSTPTR=IV2
C                INDX=IRSH16 (OVDTA(IV2,5),8)
C                IF (INDX .EQ. 0) GOTO 3240
C
C       -- climb to the parent, take ITS next sibling, and keep climbing
C       while there is none, which is preorder succession and only works
C       if the field names the PARENT.  IV2=0 means the root was reached.
C       The low four bits are the page: every other reader takes them as
C       "IAND16 (OVDTA(I,6),15)".
C
C       STORING THE LEVEL HERE SENT THE LINK COMMAND TO A SEGMENT INDEX
C       THAT DOES NOT EXIST AND IT REPORTED "ERROR 22, COMMAND OUT OF
C       ORDER" FROM OVLY LABEL 3250.
C
C       THE PARENT IS LAST(LEV), THE LAST NODE DECLARED ONE LEVEL UP --
C       THE SAME VALUE THE FIRST-CHILD LINK BELOW USES.
C
        IPAR=0
        IF (LEV .GE. 1) IPAR=LAST(LEV)
        OVDTA(OVPTR,6)=ILSH16 (IPAR,4)
C
C       LINK IT: NEXT SIBLING OF THE PREVIOUS NODE AT THIS LEVEL, OR
C       FIRST CHILD OF THE ENCLOSING ONE.
C
        IF (PREV(LEV+1) .EQ. 0) GO TO 120
        I=PREV(LEV+1)
        OVDTA(I,5)=IOR16 (OVDTA(I,5),ILSH16 (OVPTR,8))
        GO TO 130
120     CONTINUE
        IF (LEV .EQ. 0) GO TO 130
        I=LAST(LEV)
        IF (I .NE. 0)
     *  OVDTA(I,5)=IOR16 (OVDTA(I,5),IAND16 (OVPTR,255))
130     CONTINUE
        PREV(LEV+1)=OVPTR
        LAST(LEV+1)=OVPTR
        GO TO 100
C
C       LEFT PARENTHESIS -- DOWN A LEVEL, AND NOTHING IS YET LINKED
C       THERE.
C
200     CONTINUE
        LEV=LEV+1
        IF (LEV .GT. 15) GO TO 800
        PREV(LEV+1)=0
        GO TO 100
C
C       RIGHT PARENTHESIS -- BACK UP A LEVEL.
C
300     CONTINUE
        LEV=LEV-1
        IF (LEV .LT. 0) GO TO 900
        GO TO 100
C
C       TOO MANY OVERLAYS, OR TOO DEEP
C
800     CONTINUE
        CALL ERRMES (33)
900     CONTINUE
        RETURN
        END
