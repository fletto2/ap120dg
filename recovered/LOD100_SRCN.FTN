C+++ SRCN
C****** SRCN = ADD EXECUTABLES TO THE HASI = RECONSTRUCTION
C
C       NOT RECOVERED FPS SOURCE.  THE BODY WAS LOST WHERE THE TAPE FILE
C       WAS TRUNCATED -- ONLY SRCN'S DECLARATIONS SURVIVE -- BUT IT IS
C       FULLY SPECIFIED BY THREE INDEPENDENT SOURCES:
C
C         SIGNATURE   FROM ITS CALLER IN LOAD1:
C                     CALL SRCN (PRGDAT(4),PRGDAT(8),IDXFCL,HASIMD,
C                                LOCPTR)
C         PURPOSE     FROM ITS OWN SURVIVING BANNER:
C                     "SRCN = ADD EXECUTABLES TO THE HASI = REL. 1.01"
C         OUTPUT      FROM LOADER MANUAL FIGURE 4-3, WHICH PRINTS THE
C                     WHOLE GENERATED HASI SUBROUTINE
C
C       THE ARGUMENT MEANINGS ARE SRC1'S, WHICH IS RECOVERED AND IS THIS
C       ROUTINE'S SIBLING -- SRC1 "CREATE BEGINNING HASI ROUTINE" EMITS
C       THE SUBROUTINE STATEMENT, COMMON /APLDCM/ AND THE REFERENCED
C       COMMONS; SRCN THEN ADDS THE EXECUTABLE STATEMENTS:
C
C         DBSTRT = INDEX INTO DBDTA0 WHERE THIS ROUTINE'S COMMON
C                  POINTERS START
C         DBEND  = INDEX INTO DBDTA0 WHERE THEY END
C         EINDX  = INDEX OF THE ENTDTA ENTRY THAT IS FORTRAN CALLABLE
C         HASIMD = 1 FOR AN ADC HASI, 2 FOR A UDC
C         LOCPTR = THE ROUTINE'S PS LOCATION, AS STORED IN PRGDAT(9)
C
C       WHAT FIGURE 4-3 SHOWS, AND WHAT THIS EMITS:
C
C             IF (IDLM.NE.n) CALL L nnn      LOAD THE MODULE ONCE
C             IPAV(1)=nparam
C             IPA=IPPAAD                     PARAMETER PASSING AREA
C             IPAV(k)=IPA / IPA=IPA+size     ONE PAIR PER PARAMETER
C             CALL APPUT (Pk,IPAV(k),IPAV(k+1)-IPAV(k),1)
C             CALL APRUN (loc,...)
C             CALL APGET (Cnnnn,...)         FOR COMMONS COMING BACK
C             CALL APWD
C             CALL APEXC
C             RETURN
C             END
C
C       IDLM GUARDS AGAINST LOADING THE MODULE TWICE; IPPAAD IS THE
C       PARAMETER PASSING AREA WHOSE ".PPA." SYMBOL FINISH INSERTS; THE
C       AP CALLS ARE IAPEX.  A UDC HASI (HASIMD=2) OMITS THE PARAMETER
C       PASSING ENTIRELY -- MANUAL 4.3: "THE SECTIONS CONTROLLING THE
C       PASSING OF PARAMETERS ARE MISSING IN THE UDC ROUTINE".
C
        SUBROUTINE SRCN (DBSTRT,DBEND,EINDX,HASIMD,LOCPTR)
C
        INTEGER DBSTRT,DBEND,EINDX,HASIMD,LOCPTR
        INTEGER LUNX,NPAR,I,K,ISZ,IZ
        COMMON /LDTABS/ PRGDTA (503),PRGMAX,ENTDTA(503),ENTMAX,         LDTABS
     *                EXTDTA(283),EXTMAX,EX1PTR,                        LDTABS
     *                OLUN,RADIX,CLUN,MDLOW,PSLOW,                      LDTABS
     *                PSBRK,DBDTA1(203),DB1MAX,DBDTA2(150,2),DB2MAX,    LDTABS
     *                DB2PTR,OVDTA(16,9),OVPTR,OVMAX,LRADIX,PSMAX,      LDTABS
     *                DBST,DBBRK,DB0PTR,DB0MAX,DBDTA0(70),              LDTABS
     *                EXTDT1(200),                                      LDTABS
     *                EXTMX1,ENTDT1(100),ENTMX1,ENTPT1,LMLUN,           LDTABS
     *                PARDTA(100),PARMAX,PARPTR,FLUN,VARSIZ(3),         LDTABS
     *                CNTMAX,PARADR,MAXPAR,OVID,OVFLG,LMID,             LDTABS
     *                OVPG,DBPG,BUFFER(200),BUFSIZ,PAKFAC,              LDTABS
     *                DBLUN,EKOFLG,EKOLUN,CLUNS(2),CCLUN,CUROV,         LDTABS
     *                NOTUS1,NOTUS2,NOTUS3,LUNMAP,OFFSET,EXTHST,M65536  LDTABS
        COMMON /LDTABS/ SFFIL(31),SOFIL(31),SLMFIL(31),PGINFO(16,2)     LDTABS
        COMMON /LDTABS/ SCLUN(16),SCLUN2(16),CLUN2                      LDTABS
        COMMON /LDTABS/ PPASZ,OTOFLG,OVLEVL,CALFLG,CMPFLG,RSTRCT,       LDTABS
     *                  PSHLD,OV1FLG,MAPLUN,NAMLUN,LP2LUN,SLP2NM(16)    LDTABS
        COMMON /LDTABS/FLMLUN,FLMFIL,LMLDSW,MXDATA,SUBCNT,              LDTABS
     *               CODPTR,LMHDRC                                      LDTABS
        INTEGER PRGDTA,PRGMAX,ENTDTA,ENTMAX,                            LDTABS
     *          EXTDTA,EXTMAX,EX1PTR,                                   LDTABS
     *          OLUN,RADIX,CLUN,MDLOW,PSLOW,                            LDTABS
     *          PSBRK,DBDTA1,DB1MAX,DBDTA2,DB2MAX,                      LDTABS
     *          DB2PTR,OVDTA,OVPTR,OVMAX,LRADIX,PSMAX,                  LDTABS
     *          DBST,DBBRK,DB0PTR,DB0MAX,DBDTA0,EXTDT1,                 LDTABS
     *          EXTMX1,ENTDT1,ENTMX1,ENTPT1,LMLUN,                      LDTABS
     *          PARDTA,PARMAX,PARPTR,FLUN,VARSIZ,                       LDTABS
     *          CNTMAX,PARADR,MAXPAR,OVID,OVFLG,LMID,                   LDTABS
     *          OVPG,DBPG,BUFFER,BUFSIZ,PAKFAC,                         LDTABS
     *          DBLUN,EKOFLG,EKOLUN,CLUNS,CCLUN,CUROV,                  LDTABS
     *          NOTUS1,NOTUS2,NOTUS3,LUNMAP,OFFSET,EXTHST,M65536        LDTABS
        INTEGER SFFIL,SOFIL,SLMFIL,PGINFO                               LDTABS
        INTEGER SCLUN,SCLUN2,CLUN2                                      LDTABS
        INTEGER PPASZ,OTOFLG,OVLEVL,CALFLG,CMPFLG,RSTRCT,PSHLD,OV1FLG   LDTABS
        INTEGER MAPLUN,NAMLUN,LP2LUN,SLP2NM                             LDTABS
        INTEGER FLMLUN,FLMFIL(31),LMLDSW,MXDATA,SUBCNT,                 LDTABS
     *           CODPTR,LMHDRC(8)                                       LDTABS
C
        LUNX=FLUN+LUNMAP
C
C       LOAD THE MODULE IF IT IS NOT ALREADY IN.
C
        WRITE (LUNX,900) LMID,LMID
900     FORMAT (6X,'IF (IDLM.NE.',I3,') CALL L ',I3)
C
C       PARAMETER PASSING -- ADC ONLY.  MANUAL 4.3.
C
        IF (HASIMD .NE. 1) GO TO 300
        NPAR=PARMAX
        IF (NPAR .LT. 0) NPAR=0
        WRITE (LUNX,910) NPAR
910     FORMAT (6X,'IPAV(1)=',I5)
        WRITE (LUNX,920)
920     FORMAT (6X,'IPA=IPPAAD')
        IF (NPAR .LE. 0) GO TO 300
        DO 200 I=1,NPAR
        K=I+1
        WRITE (LUNX,930) K
930     FORMAT (6X,'IPAV(',I3,')=IPA')
        ISZ=1
        WRITE (LUNX,940) ISZ
940     FORMAT (6X,'IPA=IPA+',I5)
        WRITE (LUNX,950) I,K,K+1,K
950     FORMAT (6X,'CALL APPUT (P',I3,',IPAV(',I3,'),IPAV(',I3,
     *          ')-IPAV(',I3,'),1)')
200     CONTINUE
300     CONTINUE
C
C       RUN IT, WAIT, AND RELEASE.
C
        WRITE (LUNX,960) LOCPTR
960     FORMAT (6X,'CALL APRUN (',I6,',1,1,0,13)')
        WRITE (LUNX,970)
970     FORMAT (6X,'CALL APWD'/6X,'CALL APEXC'/6X,'RETURN'/6X,'END')
        RETURN
        END
