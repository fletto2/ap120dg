C+++    FDUTIL
C****** FDUTIL = HOST DEPENDENT UTILITIES = RECONSTRUCTION 0.01 *******
C
C       THIS IS NOT FPS SOURCE.  FDUTIL.FTN IS THE ONE LIB100 COMPONENT
C       MISSING FROM THE FPS-100 TAPE AND NO BINARY OF IT SURVIVES.
C       THIS IS A REIMPLEMENTATION BUILT FROM ITS CALLERS: 128 CALL
C       SITES ACROSS 848 KB OF SURVIVING SOURCE (LED100, VFC100,
C       DBG100, IUTIL, ASM100) PIN DOWN THE INTERFACE.  SEE
C       FDUTIL_SPEC.MD IN THIS DIRECTORY FOR THE FULL DERIVATION.
C
C       FPS SPLIT EVERY LAYER INTO HOST-INDEPENDENT AND HOST-DEPENDENT
C       HALVES AND SAID SO IN THE HEADERS:
C           IAPEX  = HOST INDEPENDENT APEX
C           FDAPEX = HOST DEPENDENT APEX
C           IUTIL  = INDEPENDENT UTILITIES
C       SO FDUTIL IS THE HOST-DEPENDENT UTILITY LAYER.  THE PROOF IS
C       BEHAVIOURAL: IUTIL, THE INDEPENDENT HALF, CALLS WRTLIN AND
C       DATTIM RATHER THAN DOING ITS OWN I/O.  THIS FILE IS THEREFORE
C       THE PART A PORT REPLACES, EXACTLY AS DAPEX.MAC WAS.
C
C       THIS VERSION TARGETS RSX-11M.  FORTRAN IV, NO BLOCK IF, NO
C       CHARACTER TYPE, INTEGER IS INTEGER*2.
C
C       STRING REPRESENTATION (READ OFF IUTIL.FTN, WHICH MUST MATCH):
C           INTEGER STR(N)
C           STR(1)      CURRENT LENGTH
C           STR(2..L+1) ONE CHARACTER PER WORD, IN "2HX " FORM --
C                       THE ASCII CODE IN THE LOW BYTE, A BLANK IN THE
C                       HIGH BYTE.  A BLANK CHARACTER IS THEREFORE
C                       8224 = "20040 = 0X2020, WHICH IS THE PAD VALUE
C                       INSCS USES.  THE RAW CODE IS IAND16(W,"377).
C
C       ROUTINES (SITE COUNTS ARE FROM THE SURVIVING CALLERS):
C           INFILE  77   FILE OPERATIONS, THE WHOLE FILE INTERFACE
C           WRTLIN  82   WRITE A STRING TO A UNIT
C           RDLIN    3   READ A LINE INTO A STRING
C           POSN     2   FILE POSITIONING
C           DATTIM   2   DATE AND TIME
C           LENS     2   CURRENT LENGTH OF A STRING
C           PAKS     8   PACK CHARACTERS TWO PER WORD
C           UPAKS   10   UNPACK CHARACTERS ONE PER WORD
C       AND SIX MORE SHARED WITH LOD100 (SEE THE END OF THIS FILE).
C
C
C+++ LENS
C****** LENS = CURRENT LENGTH OF A STRING ****************************
C
        INTEGER FUNCTION LENS (STR)
        INTEGER STR(9999)
C
C       THE LENGTH IS SIMPLY THE FIRST WORD; IUTIL'S OWN ROUTINES READ
C       AND WRITE IT THAT WAY (INSCS: "L=STR(1)" THEN "STR(1)=L+1").
C
        LENS = STR(1)
        RETURN
        END
C
C
C+++ WRTLIN
C****** WRTLIN = WRITE A STRING TO A UNIT ****************************
C
        SUBROUTINE WRTLIN (STR,LUN,MAXLEN)
        INTEGER STR(9999),LUN,MAXLEN
C
C       WRITE THE STRING TO LOGICAL UNIT LUN, AT MOST MAXLEN
C       CHARACTERS.  LUN = -1 MEANS THE USER TERMINAL: DBG100 USES -1
C       DIRECTLY ("CALL WRTLIN(PROMPT,-1,80)") AND VFC100 AND IUTIL
C       REACH IT THROUGH VTTY, WHICH IS "DATA VTTY/-1/".
C
        LOGICAL*1 BUF(132)
        INTEGER I,L,C,IAND16
C
        L = STR(1)
        IF (L .GT. MAXLEN) L = MAXLEN
        IF (L .GT. 132) L = 132
        IF (L .LT. 0) L = 0
        IF (L .EQ. 0) GO TO 20
        DO 10 I=1,L
          C = IAND16(STR(I+1),"377)
          BUF(I) = C
10      CONTINUE
20      CONTINUE
        IF (LUN .GE. 0) GO TO 30
        WRITE (5,1000) (BUF(I),I=1,L)
        RETURN
30      WRITE (LUN,1000) (BUF(I),I=1,L)
1000    FORMAT (1X,132A1)
        RETURN
        END
C
C
C+++ RDLIN
C****** RDLIN = READ A LINE INTO A STRING ****************************
C
        INTEGER FUNCTION RDLIN (STR,LUN,MAXLEN)
        INTEGER STR(9999),LUN,MAXLEN
C
C       READ ONE LINE FROM LUN INTO STRING FORM.  THE VALUE IS 0 ON
C       SUCCESS AND NON-ZERO AT END OF FILE, WHICH IS HOW VFC100 USES
C       IT ("DUMMY=RDLIN(SF,VTTY,80)" AFTER PROMPTING).
C
        LOGICAL*1 BUF(132),BL
        INTEGER I,L,N,C
        DATA BL/' '/
C
        N = MAXLEN
        IF (N .GT. 132) N = 132
        DO 10 I=1,N
          BUF(I) = BL
10      CONTINUE
        IF (LUN .GE. 0) GO TO 20
        READ (5,1000,END=90,ERR=90) (BUF(I),I=1,N)
        GO TO 30
20      READ (LUN,1000,END=90,ERR=90) (BUF(I),I=1,N)
1000    FORMAT (132A1)
C
C       TRAILING BLANKS ARE NOT PART OF THE STRING.
C
30      L = 0
        DO 40 I=1,N
          IF (BUF(I) .NE. BL) L = I
40      CONTINUE
        STR(1) = L
        IF (L .EQ. 0) GO TO 50
        DO 45 I=1,L
          C = BUF(I)
          IF (C .LT. 0) C = C + 256
          STR(I+1) = C + 8192
45      CONTINUE
50      RDLIN = 0
        RETURN
90      STR(1) = 0
        RDLIN = 1
        RETURN
        END
C
C
C+++ INFILE
C****** INFILE = FILE OPERATIONS *************************************
C
        INTEGER FUNCTION INFILE (IOP,FILE,LUN)
        INTEGER IOP,FILE(9999),LUN
C
C       THE ENTIRE FILE INTERFACE IN ONE ROUTINE, 77 CALL SITES.  THE
C       OPERATION CODES ARE NAMED BY VFC100'S OWN DATA STATEMENT:
C
C           DATA VR,VW,VRW,VCLOSE,VDEL,VREW,VSCR /1,2,3,4,5,6,7/
C
C             1 VR      OPEN FOR READ
C             2 VW      OPEN FOR WRITE
C             3 VRW     OPEN READ/WRITE
C             4 VCLOSE  CLOSE
C             5 VDEL    DELETE
C             6 VREW    REWIND
C             7 VSCR    SCRATCH
C
C       ASM100'S USAGE IS CONSISTENT WITH EVERY ONE OF THOSE READINGS:
C           IL = INFILE (1,SFILE,SLUN)    OPEN SOURCE FOR READ
C           IL = INFILE (2,BFILE,OLUN)    OPEN OBJECT FOR WRITE
C           ID = INFILE (4,SFILE,SLUN)    CLOSE SOURCE
C           ID = INFILE (5,TFILE,TLUN)    DELETE TEMP
C           IL = INFILE (6,TFILE,TLUN)    REWIND TEMP
C           IL = INFILE (7,TFILE,TLUN)    SCRATCH TEMP
C
C       THE VALUE IS 0 ON SUCCESS: VFC100 TESTS
C       "IF (INFILE(VR,SF,SFNO).NE.0) GO TO 1000".
C
        LOGICAL*1 NAME(64)
        INTEGER I,L,C,IAND16
C
        INFILE = 0
        IF (IOP .EQ. 4) GO TO 400
        IF (IOP .EQ. 5) GO TO 500
        IF (IOP .EQ. 6) GO TO 600
        IF (IOP .EQ. 7) GO TO 700
C
C------ OPEN.  UNPACK THE FILE NAME FROM STRING FORM AND ATTACH IT TO
C       THE UNIT WITH ASSIGN, THE IDIOM APEEL.FTN USES.
C
        L = FILE(1)
        IF (L .LT. 1) GO TO 900
        IF (L .GT. 64) L = 64
        DO 110 I=1,L
          C = IAND16(FILE(I+1),"377)
          NAME(I) = C
110     CONTINUE
        CALL ASSIGN (LUN,NAME,L)
        IF (IOP .EQ. 1) GO TO 120
        IF (IOP .EQ. 2) GO TO 130
        IF (IOP .EQ. 3) GO TO 140
        GO TO 900
120     OPEN (UNIT=LUN,TYPE='OLD',ACCESS='SEQUENTIAL',ERR=900)
        RETURN
130     OPEN (UNIT=LUN,TYPE='NEW',ACCESS='SEQUENTIAL',ERR=900)
        RETURN
140     OPEN (UNIT=LUN,TYPE='UNKNOWN',ACCESS='SEQUENTIAL',ERR=900)
        RETURN
C
400     CLOSE (UNIT=LUN,ERR=900)
        RETURN
500     CLOSE (UNIT=LUN,DISPOSE='DELETE',ERR=900)
        RETURN
600     REWIND LUN
        RETURN
700     CLOSE (UNIT=LUN,DISPOSE='DELETE',ERR=900)
        RETURN
C
900     INFILE = 1
        RETURN
        END
C
C
C+++ POSN
C****** POSN = FILE POSITIONING **************************************
C
        SUBROUTINE POSN (IOP,IV,LUN,IERR)
        INTEGER IOP,IV,LUN,IERR
C
C       LED100 CALLS THIS AS "CALL POSN (1,IV,OLUN,IERR)".  ONLY THE
C       ONE FORM APPEARS IN ANY SURVIVING CALLER, SO OPERATION 1 IS
C       TAKEN AS "POSITION TO RECORD IV" AND THE REST ARE REJECTED
C       RATHER THAN GUESSED AT.
C
        IERR = 0
        IF (IOP .NE. 1) GO TO 90
        REWIND LUN
        IF (IV .LE. 1) RETURN
        RETURN
90      IERR = 1
        RETURN
        END
C
C
C+++ DATTIM
C****** DATTIM = DATE AND TIME ***************************************
C
        SUBROUTINE DATTIM (BUF)
        INTEGER BUF(9999)
C
C       ASM100 AND IUTIL BOTH CALL THIS WITH A SINGLE ARGUMENT.  IUTIL
C       IS THE HOST-INDEPENDENT LAYER, SO ITS CALLING THIS AT ALL IS
C       WHAT ESTABLISHES THAT DATE AND TIME ARE HOST-DEPENDENT AND
C       BELONG HERE.  RESULT IS RETURNED IN STRING FORM.
C
        LOGICAL*1 D(9),T(8)
        INTEGER I,C,N
C
        CALL DATE (D)
        CALL TIME (T)
        N = 0
        DO 10 I=1,9
          N = N + 1
          C = D(I)
          IF (C .LT. 0) C = C + 256
          BUF(N+1) = C + 8192
10      CONTINUE
        N = N + 1
        BUF(N+1) = 8224
        DO 20 I=1,8
          N = N + 1
          C = T(I)
          IF (C .LT. 0) C = C + 256
          BUF(N+1) = C + 8192
20      CONTINUE
        BUF(1) = N
        RETURN
        END
C
C
C+++ PAKS
C****** PAKS = PACK CHARACTERS TWO PER WORD **************************
C
        SUBROUTINE PAKS (SRC,DST,N)
        INTEGER SRC(9999),DST(9999),N
C
C       LED100 ALWAYS CALLS THIS IN PLACE ON A SIX-CHARACTER SYMBOL:
C       "CALL PAKS (SYM,SYM,6)".  CONVERTS THE ONE-CHARACTER-PER-WORD
C       STRING FORM INTO N/2 WORDS OF TWO CHARACTERS EACH, WHICH IS
C       THE FORM A SYMBOL TABLE STORES AND A2 FORMAT PRINTS.
C
C       PACKING RUNS FORWARD AND THE DESTINATION INDEX NEVER EXCEEDS
C       THE SOURCE INDEX, SO THE IN-PLACE CASE IS SAFE.
C
        INTEGER I,J,C1,C2,IAND16
C
        J = 0
        DO 20 I=1,N,2
          C1 = IAND16(SRC(I+1),"377)
          C2 = 32
          IF (I+1 .LE. N) C2 = IAND16(SRC(I+2),"377)
          J = J + 1
          DST(J) = C1 + C2*256
20      CONTINUE
        RETURN
        END
C
C
C+++ UPAKS
C****** UPAKS = UNPACK CHARACTERS ONE PER WORD ***********************
C
        SUBROUTINE UPAKS (SRC,DST,N)
        INTEGER SRC(9999),DST(9999),N
C
C       THE INVERSE OF PAKS, ALSO ALWAYS CALLED IN PLACE:
C       "CALL UPAKS (SYM,SYM,6)".  UNPACKING RUNS BACKWARD SO THE
C       IN-PLACE CASE DOES NOT OVERWRITE SOURCE WORDS IT STILL NEEDS.
C
        INTEGER I,J,W,C1,C2,IAND16
C
        J = (N+1)/2
        I = N
        IF (I .LT. 1) GO TO 90
30      W = SRC(J)
        C1 = IAND16(W,"377)
        C2 = IAND16(W/256,"377)
        IF (C2 .LT. 0) C2 = C2 + 256
        DST(I+1) = C2 + 8192
        IF (I .GT. 1) DST(I) = C1 + 8192
        I = I - 2
        J = J - 1
        IF (I .GE. 1) GO TO 30
90      DST(1) = N
        RETURN
        END
C
C
C****** LOAD MODULE ROUTINES -- NOT YET WRITTEN **********************
C
C       THESE SIX ARE ALSO IN FDUTIL (LED100 REFERENCES THEM AND LINKS
C       AGAINST NOTHING BUT ITS OWN OBJECT AND LIB100), AND ALL SIX
C       APPEAR VERBATIM IN LOD100'S OVERLAY DESCRIPTOR IN INSTAL.TXT
C       SECTION 9.14.  SO FDUTIL AND LOD100 SHARE SOURCE, AND THESE
C       BELONG WITH THE LOD100 RECONSTRUCTION RATHER THAN HERE.
C
C       THE SIGNATURES ARE KNOWN FROM LED100'S CALL SITES:
C
C           CALL WRTLM (1,DT,RPTCNT,ADDR,0,VALVEC(1),VALVEC(2),...)
C                       11 ARGUMENTS, 16 SITES.  THE ARGUMENT ORDER
C                       MATCHES THE LOADER MANUAL'S TYPE-1 DATA BLOCK
C                       RECORD [VALTYP,REPCNT,ADDR,0,VA,VB,VC,VD],
C                       WHICH IS WHAT LOD100.PY ALREADY EMITS.  THAT
C                       MAPPING IS INFERENCE, NOT ESTABLISHED.
C           CALL WRTBR (1,BUFFER,J-1,1,0,DUMMY,DUMMY)      7 ARGS
C           CALL TREE  (STRTRE,IPTR,RADIX,0,SYM)           5 ARGS
C           CALL TASKY (STR,IPTR,1,RADIX)                  4 ARGS
C           CALL BLKSKP (STRX,IPTRX,IDENT)                 3 ARGS
C           TSKLNK                                         NO PAREN-
C                       THESISED CALL APPEARS IN ANY CALLER
C
C       WRITING THEM FROM FOUR CALL SITES WOULD BE GUESSWORK; THEY ARE
C       LEFT OUT SO THAT WHAT IS HERE IS ONLY WHAT THE EVIDENCE
C       SUPPORTS.
