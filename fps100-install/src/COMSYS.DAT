"
MNSIZE = 43.           "SIZE OF ONE MINIMUM SAVE AREA
SYSIZE = MNSIZE * 10.  "SIZE OF STACKED SYSTEM SAVE AREA
"
$INTEGER         NEWTSK, CURTSK, LSTFUL, SYSAVE, SYSPTR, SYSTOP,
                 CRATE, CLKQUE, NEVER, MORGUE,
                 TIMOUT, LOGITS, LOGIOD, SSAREA
$COMMON /READYQ/ RDYQUE(4) /I
$COMMON /SYSCOM/ NEWTSK, CURTSK, LSTFUL, SYSAVE, SYSPTR, SYSTOP,
                 CRATE, CLKQUE(4), NEVER(6), MORGUE(6),
                 TIMOUT(6), LOGITS, LOGIOD, SSAREA(SYSIZE)
"
