C****** APEEL = PEEL APART APLIB MODULES = REV 4.0, NOV 79 *******************
        INTEGER INFIL,JCLFIL,OUTFIL,IQ,LS,LL,FIRST,FIRJCL
        LOGICAL*1 TTBUF(80),LSPACE
        LOGICAL*1 BUFF(80),BUF(80)
        LOGICAL*1 I1,I2
        DATA I1,I2/'1','2'/
        DATA LSPACE/' '/
        INFIL=1
        OUTFIL=2
        CALL GETMCR(TTBUF,IDS)
        IF(IDS.LE.4)GO TO 998
        IDS=IDS-6
        CALL ASSIGN(INFIL,TTBUF(7),IDS)
        IFLG=0
        IF(TTBUF(5).NE.I1) GOTO 5
        OPEN(UNIT=OUTFIL,TYPE='NEW',NAME='APLIB.OBJ',
     1 ACCESS='SEQUENTIAL')
        GOTO 6
5       CONTINUE
       OPEN(UNIT=OUTFIL,TYPE='OLD',NAME='APLIB.OBJ',
     1 ACCESS='APPEND')
6       CONTINUE
        GOTO 200
200     READ(INFIL,205,END=1000) BUFF
        IF(IFLG.EQ.0)GOTO 207
        IF(IFLG.EQ.2.OR.TTBUF(5).EQ.I1)
     1  WRITE (OUTFIL,205)(BUF(I),I=1,JJ)
207     CONTINUE
205     FORMAT(80A1)
        IF (IFLG.EQ.1)IFLG=2
        IF (IFLG.EQ.0)IFLG=1
        DO 210 I=1,80
        J=80-I+1
        IF (BUFF(J).NE.LSPACE) GO TO 220
210     CONTINUE
220     CONTINUE
        DO 215 I=1,J
215     BUF(I)=BUFF(I)
        JJ=J
        GO TO 200
998     TYPE 999
999     FORMAT(' PLEASE INCLUDE INPUT FILE ON COMMAND LINE!!!')
1000    CONTINUE
        IF(TTBUF(5).EQ.I2)WRITE(OUTFIL,205)(BUF(I),I=1,JJ)
        CALL CLOSE(OUTFIL)
        CALL CLOSE(INFIL)
        CALL EXIT
        END
