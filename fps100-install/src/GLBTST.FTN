C****** GLBTST = GLOBAL TEST FOR FPS100 PDS = REL 0.0, AUG 79
C
C
C****** PDSTST = GLOBAL TEST FOR FPS-100 PDS = REL 0.0, AUG 79
C
C
C    --- ABSTRACT ---
C
C  THIS PROGRAM IS A GLOBAL TEST OF THE FPS-100 PROGRAM DEVELOPMENT
C  SOFTWARE.  IT IS NOT A COMPLETE TEST OF THE WORKINGS OF ALL THE
C  PDS SOFTWARE, INSTEAD IT TESTS THE INTERACTION OF THE PDS PRODUCTS.
C
        INTEGER FONE,FTWO,SARRAY,SIZE
C
C  DEFINE COMMON ADDRESS
C
        FONE = 1
        FTWO = FONE+1
        SARRAY = FTWO+1
        SIZE = 32
C
C  START OFF BY CALLING SEQV1 TO BUILD SARRAY AND FONE AND FTWO.
C
        CALL SEQV1
C
C  NOW PROCEED TO BUILD AN ARRAY (FARRAY) WITH SEQUENTIAL NUMBERS
C  AND SCALE IT BY 2.
C
        CALL VRAMP(FONE,FONE,FARRAY,1,SIZE)
        CALL VSMUL(FARRAY,1,FTWO,FARRAY,1,SIZE)
C
C  NEXT FLOAT SARRAY BUILT BY SEQV1 AND IARRAY AND ADD THEM TOGETHER
C  PLACING THE RESULTS IN NARRAY.  THEN FIX NARRAY AND RETURN
C
        CALL VFLT(IARRAY,1,IARRAY,1,SIZE)
        CALL VFLT(SARRAY,1,NARRAY,1,SIZE)
        CALL VADD(IARRAY,1,NARRAY,1,NARRAY,1,SIZE)
        CALL VFIX(NARRAY,1,NARRAY,1,SIZE)
C
        END
