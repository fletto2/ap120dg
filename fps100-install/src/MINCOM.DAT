"
MNSIZE = 43.           "SIZE OF ONE MINIMUM SAVE AREA
SYSIZE = MNSIZE * 10.  "SIZE OF STACKED SYSTEM SAVE AREA
"
$INTEGER         SYSAVE, SYSPTR, SYSTOP,
                 LOGITS, LOGIOD, SSAREA
$COMMON /READYQ/ RDYQUE(2) /I
$COMMON /SYSCOM/ SYSAVE, SYSPTR, SYSTOP,
                 LOGITS, LOGIOD, SSAREA(SYSIZE)
"
