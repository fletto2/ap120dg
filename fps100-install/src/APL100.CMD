; APL100.CMD - INSTALL APLIB COMMAND FILE
; RSX11M FPS100 FEB 80
; ALL AP OBJECT FILES (.APO)
; APEEL MUST BE BUILT
;
 .ENABLE GLOBAL
 .ENABLE SUBSTITUTION
 .IFDF $MAST .GOTO 10
; SETUP
 @SETUP
;
 .10:
 SET /UIC='$LUIC'
 PIP '$LBDSK'APLIB.*;*/DE   ! ERROR MESSAGE HERE IS O.K.
 SET /UIC='$WUIC'
;
; READ PASS 4 FROM INSTALLATION TAPE
;
 .SETN $PASS 4
 @TREAD
;
 .IFNINS APE INS APEEL/TASK=...APE
 .IFINS APE .GOTO 15
; APEEL CANNOT BE FOUND !!! CORRECT THIS, INSTALL APEEL BEFORE RESUMING.
 .PAUSE
 .15:
;
; INSTALL APLIB LIBRARY
;
 .SETS NO "1"
 .IFNDF $AML .GOTO 20
;
; ADVANCED MATH LIBRARY
;
 APE 'NO',AMLLIB.APO
 .SETS NO "0"
;RM; PIP AMLLIB.APO;1/DE
 .20: .IFNDF $IPR .GOTO 30
;
; IMAGE PROCESSING LIBRARY
;
 APE 'NO',IPRLIB.APO
 .SETS NO "0"
;RM; PIP IPRLIB.APO;1/DE
 .30: .IFNDF $TMR .GOTO 40
;
; TMR LIBRARY
;
 APE 'NO',TMRLIB.APO
 .SETS NO "0"
;RM; PIP TMRLIB.APO;1/DE
 .40: .IFNDF $SIG .GOTO 50
;
; SIGNAL PROCESSING LIBRARY
;
 APE 'NO',SIGLIB.APO
 .SETS NO "0"
;RM; PIP SIGLIB.APO;1/DE
 .50: .IFNDF $BASLB .GOTO 60
;
; BASIC MATH LIBRARIES
;
 APE 'NO',BAALIB.APO
;RM; PIP BAALIB.APO;1/DE
 .SETS NO "0"
 APE 'NO',BABLIB.APO
;RM; PIP BABLIB.APO;1/DE
 APE 'NO',UTLLIB.APO
;RM; PIP UTLLIB.APO;1/DE
 APE 'NO',APFLIB.APO
;RM; PIP APFLIB.APO;1/DE
 .60:
;
; SYMLIB AND DGNLIB LIBRARIES
;
 APE 'NO',SYMLIB.APO
;RM; PIP SYMLIB.APO;1/DE
 APE 2,DGNLIB.APO
;RM; PIP DGNLIB.APO;1/DE
;
; TRANSFER APLIB TO SYSTEM DISK
;
 SET /UIC='$LUIC'
 PIP '$LBDSK'APLIB.LIB='$WUIC'APLIB.OBJ
 SET /UIC='$WUIC'
 PIP APLIB.OBJ;*/DE
 .EXIT
