; Standard Data General Nova device codes
; Include with: (paste at top of your .asm file)

dev MDV  = 001   ; Multiply/Divide unit
dev MAP  = 002   ; Memory Management Unit
dev TTI  = 010   ; TTY Input
dev TTO  = 011   ; TTY Output
dev PTR  = 012   ; Paper Tape Reader
dev PTP  = 013   ; Paper Tape Punch
dev RTC  = 014   ; Real Time Clock
dev PLT  = 015   ; Plotter
dev CDR  = 016   ; Card Reader
dev LPT  = 017   ; Line Printer
dev DSK  = 020   ; Moving Head Disk (DG models)
dev DKP  = 033   ; Disk Pack
dev DZP  = 034   ; Disk (alternate)
dev MTA  = 022   ; Magnetic Tape
dev FPS  = 055   ; Floating Point Systems AP-120B / FPS-100
dev CPU  = 077   ; CPU (used by READS, MSKO, INTA, HALT, IORST, INTEN, INTDS)
