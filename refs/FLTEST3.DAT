"****** INSERT = INSERT FOR SEQV1.S  = REL 0.0 , SEP 79
"  DEFINE COMMON VARIABLES
"
        $REAL FONE,FTWO
        $INTEGER SARRAY
"
"  DEFINE MD COMMON
"
        $COMMON /COMM/ FONE,FTWO,SARRAY(32.)
"
"  DEFINE DATA
"
        $DATA FONE      1.1
        $DATA FTWO      0.3
"
"  DEFINE SPAD REGISTER
"
        R0 = 0          "SP 0
"  NOW START A LOOP BUILDING SARRAY WITH A RAMP FUNCTION.
"
SEQV1:  LDSPI R0;DB=32.         "R0 = SIZE OF VECTOR SARRAY
