      SUBROUTINE !ONE
      COMMON /APLDCM/ IPAV( 33),NU2,IDLM,NU1,IPPAAD,IPPAND,IOVS(33),
     * LMT(10,3),LMTE
      IF (IDLM.NE.  1) CALL L101
      CALL APRUN (  4097,1,1,0,13)
      CALL APWD
      CALL APEXC
      RETURN
      END
      BLOCK DATA
      COMMON /APLDCM/ IPAV( 33),NU2,IDLM,NU1,IPPAAD,IPPAND,IOVS(33),
     * LMT(10,3),LMTE
      DATA NU2,IDLM,NU1,IPPAAD,IOVS(2),LMTE
     * /0,0,0,0,0,0/
      END
